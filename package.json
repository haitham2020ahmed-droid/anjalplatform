{
  "name": "alanjal-adaptive-ela",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive English learning platform for Al-Anjal Private Schools (Grades 4-6, extensible to 1-12)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:curriculum": "tsx prisma/seed/curriculum.ts",
    "db:seed:demo": "tsx prisma/seed/demo.ts",
    "curriculum:normalize": "python3 scripts/normalize/build_curriculum.py ./kb ./data/curriculum",
    "db:seed:questions": "tsx prisma/seed/questions.ts",
    "bank:build": "python3 data/questions/build_bank.py",
    "standards:parse": "python3 scripts/normalize/parse_ccss.py ./kb/ccss.txt ./data/curriculum/ccss-standards.json",
    "db:ddl": "tsx scripts/db/gen-ddl.ts",
    "db:verify:offline": "tsx scripts/db/verify.ts",
    "db:verify:mysql": "tsx scripts/db/verify-mysql.ts",
    "jobs:rollups": "tsx scripts/jobs/nightly-rollups.ts",
    "jobs:items": "tsx scripts/jobs/item-analysis.ts",
    "reports:browser": "playwright-core install chromium",
    "reports:preview": "tsx scripts/preview/render-reports.ts ./report-preview",
    "test:contracts": "tsx --test tests/contracts.test.ts tests/isolation.test.ts",
    "e2e": "playwright test",
    "e2e:remote": "playwright test --project=desktop",
    "load:engine": "tsx scripts/load/engine-bench.ts 60 20",
    "load:http": "tsx scripts/load/http-load.ts 30 60",
    "db:keys": "tsx scripts/db/gen-unique-keys.ts",
    "test:mutation": "sh scripts/mutation/run-all.sh",
    "jobs:security": "tsx scripts/jobs/security-digest.ts",
    "jobs:scheduler": "tsx scripts/jobs/scheduler.ts",
    "db:baseline": "sh scripts/db/baseline-migration.sh",
    "start:standalone": "cp -r .next/static .next/standalone/.next/ && cp -r assets .next/standalone/ && node .next/standalone/server.js",
    "admin:create": "tsx scripts/admin/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.0.0",
    "next": "^15.0.0",
    "papaparse": "^5.4.1",
    "playwright-core": "1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
