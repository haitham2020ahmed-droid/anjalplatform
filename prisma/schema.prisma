  sourceId     String
  externalCode String
  externalName String
  gradeLevel   Int?
  skillId      String?

  source ExternalAssessmentSource @relation(fields: [sourceId], references: [id])
  skill  Skill?                   @relation(fields: [skillId], references: [id])

  @@unique([sourceId, externalCode, gradeLevel])
}

model ExternalAssessmentResult {
  id            String   @id @default(cuid())
  sourceId      String
  studentId     String
  importJobId   String?
  externalSkill String?
  score         Float?
  questions     Int?
  timeSpentSec  Int?
  takenOn       DateTime?
  raw           Json
  importedAt    DateTime @default(now())

  source  ExternalAssessmentSource @relation(fields: [sourceId], references: [id])
  student Student                  @relation(fields: [studentId], references: [id])

  @@index([studentId, sourceId])
}

/// OFFICIAL MAP Growth values — only from imported, authorised reports.
model MapResult {
  id                    String   @id @default(cuid())
  studentId             String
  importJobId           String?
  testDate              DateTime
  subject               String
  goalName              String? // goal exactly as named in the imported file; null = overall test RIT
  goalAreaId            String? // matched platform MAP goal area (null if overall or unmatched)
  /// 🐛 r91 fix ("درجات قديمة بتتحسب بصف الطالب الحالي مش صفه وقت الاختبار"): the student's grade AT TEST TIME,
  /// stamped on import. Nullable so existing rows (imported before this column existed) stay valid — those fall
  /// back to the student's current grade exactly as before (their actual test-time grade cannot be recovered).
  grade                 Int?
  rit                   Int
  ritSE                 Float?
  achievementPercentile Int?
  growthPercentile      Int?
  projectedGrowth       Int?
  termName              String?
  importedAt            DateTime @default(now())

  student  Student      @relation(fields: [studentId], references: [id])
  goalArea MapGoalArea? @relation(fields: [goalAreaId], references: [id])

  @@index([studentId, testDate])
  @@index([studentId, subject, testDate])
  /// the student's Lexile measure from the MAP report
  lexile                Int?
  /// NWEA rapid-guessing % of the test (30%+ = NWEA suggests the score may not reflect the student: retest)
  rapidGuessPct         Int?
  /// from NWEA's comprehensive data file: the growth since the previous comparable term, its conditional growth
  /// index, whether the projected growth was met, the test's minutes, the Lexile range, typical growth, the
  /// projected proficiency, and (goal rows) the goal's descriptor (Low · LoAvg · Avg · HiAvg · High)
  observedGrowth        Int?
  conditionalGrowthIndex Float?
  metProjectedGrowth    String?  @db.VarChar(8)
  testMinutes           Int?
  lexileLow             Int?
  lexileHigh            Int?
  typicalGrowth         Int?
  proficiency           String?  @db.VarChar(40)
  descriptor            String?  @db.VarChar(10)

  @@index([termName])
}

/// Benchmark reference values (class/grade/school computed; district/national ONLY when imported).
model BenchmarkReference {
  id         String   @id @default(cuid())
  scope      String // "NATIONAL" | "DISTRICT"
  metric     String // e.g. "ORF_WCPM_P50"
  gradeLevel Int
  season     String?
  value      Float
  source     String // citation of the legitimate dataset
  importedAt DateTime @default(now())

  @@unique([scope, metric, gradeLevel, season])
}

model ImportJob {
  id          String       @id @default(cuid())
  kind        ImportKind
  status      ImportStatus @default(UPLOADED)
  fileName    String
  uploadedById String
  totalRows   Int          @default(0)
  validRows   Int          @default(0)
  errorRows   Int          @default(0)
  duplicateRows Int        @default(0)
  preview     Json?
  errors      Json? // [{row, field, message}]
  fileSha256  String? // detects the same file uploaded twice
  payload     Json? // validated, normalized rows awaiting confirmation (cleared after import)
  options     Json? // e.g. {source: "IXL", duplicates: "skip"}
  summary     Json? // counts written on confirmation
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  uploadedBy User @relation(fields: [uploadedById], references: [id])
  /// Question-bank imports: one log row per detected question (preview, decision, result).
  questionLogs ImportedQuestionLog[]

  @@index([kind, status])
}

// ------------------------------------------- engagement & communication ----

model Recommendation {
  id         String   @id @default(cuid())
  studentId  String
  skillId    String
  targetLevel Int
  score      Float
  reasons    Json // [{code, detail, weight}] — internal explanation
  createdAt  DateTime @default(now())
  dismissedAt DateTime?

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
  /// where it was shown (STUDENT_HOME | NEXT_STEP), the mastery when recommended, and the outcome 7+ days later
  source         String?   @db.VarChar(16)
