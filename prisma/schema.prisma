// =============================================================================
// Al-Anjal Adaptive ELA Platform — Prisma data model (MySQL 8+)
//
// Conventions
//  * Business entities use String cuid ids (safe to expose in URLs, merge-friendly
//    for imports). High-volume event tables (attempts, adaptive logs, audit) use
//    BigInt autoincrement ids: smaller clustered indexes and fast range scans.
//  * Soft delete (`deletedAt`) on entities teachers/admins edit; never on event logs.
//  * INTERNAL metrics (mastery, theta, Platform Reading Level) and EXTERNAL
//    official data (MAP RIT, Lexile, IXL) live in separate tables and are never
//    stored in the same column.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------- enums ----

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum Domain {
  READING
  VOCABULARY
  GRAMMAR
  LANGUAGE
  WRITING
  WORD_STUDY
}

enum SkillCategory {
  LITERATURE
  INFORMATIONAL
  COMPREHENSION
  VOCABULARY
  WORD_STUDY
  GRAMMAR
  MECHANICS
  PHONICS_WORD_STUDY
  WRITING
}

enum SkillRole {
  COMPREHENSION_SKILL
  STRATEGY_AND_FEATURE
  VOCABULARY_STRATEGY
  AUTHORS_CRAFT
  GRAMMAR
  SPELLING
  WRITING
}

enum StandardFramework {
  CCSS_ELA
  MAP_CONTINUUM
  CURRICULUM_MAP
  SCHOOL_OBJECTIVE
}

enum ContentStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentOrigin {
  TEACHER_AUTHORED
  SCHOOL_BOOKLET
  IMPORTED
  AI_GENERATED
  DEMO
}

enum AiReviewStatus {
  AI_GENERATED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum SessionMode {
  ADAPTIVE_PRACTICE
  DIAGNOSTIC
  PLACEMENT
  UNIT_QUIZ
  BENCHMARK
  TEACHER_QUIZ
  FINAL
}

enum AssessmentType {
  DIAGNOSTIC
  PLACEMENT
  UNIT_QUIZ
  BENCHMARK
  TEACHER_QUIZ
  FINAL
}

enum AssignmentTarget {
  SKILL
  UNIT
  ASSESSMENT
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum MasteryBand {
  BEGINNING
  DEVELOPING
  APPROACHING
  PROFICIENT
  MASTERED
}

enum ImportKind {
  STUDENTS
  TEACHERS
  QUESTIONS
  SKILLS
  STANDARDS
  CURRICULUM_MAP
  MAP_RESULTS
  EXTERNAL_RESULTS
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  AWAITING_CONFIRMATION
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  NEW_ASSIGNMENT
  ASSIGNMENT_DUE
  SKILL_MASTERED
  TEACHER_FEEDBACK
  NEW_BADGE
  ASSESSMENT_AVAILABLE
  PARENT_PROGRESS
  INTERVENTION_ALERT
  REPORT_APPROVAL
  DAILY_DIGEST
  ADMIN_MESSAGE
  TIER_CHANGE
}

// ------------------------------------------------------ identity & access ----

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  username       String    @unique
  passwordHash   String?
  displayName    String
  role           Role
  schoolId       String?
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(0) // bump to revoke all sessions
  mustChangePassword Boolean @default(false) // set after an admin reset
  passwordChangedAt  DateTime?
  lastLoginAt    DateTime?
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  uiLang         String?   @db.VarChar(5) // interface language: "en" (default) or "ar" (menus/buttons only)
  tourSeenAt     DateTime? // first-login tour shown/skipped
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school        School?        @relation(fields: [schoolId], references: [id])
  teacher       Teacher?
  student       Student?
  parent        Parent?
  notifications Notification[]
  auditLogs     AuditLog[]
  importJobs    ImportJob[]
  sessions      Session[]

  @@index([schoolId, role])
}

/// Server-side session. The cookie holds a random token; only its SHA-256 is stored,
/// so a database leak cannot be replayed as live sessions.
model Session {
  id         String   @id // sha256(token), hex
  userId     String
  version    Int      // User.sessionVersion when created; a mismatch means "revoked everywhere"
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  ip         String?
  userAgent  String?  @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// r76 Class QR sign-in: one open QR of one class, shown by its teacher (src/server/auth/class-signin.ts).
/// The QR link carries a random 256-bit token; only its SHA-256 is stored. `code` = the short code to type instead
/// (6 letters/digits). Ends at expiresAt (10 minutes) or when the teacher closes it (closedAt).
model ClassSignIn {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.VarChar(64)
  code      String    @db.VarChar(8)
  schoolId  String
  classId   String
  teacherId String // Teacher.id of the teacher who opened it
  expiresAt DateTime
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([code])
  @@index([classId, createdAt])
}

/// r76: a student who signed in by tapping their name on a Class QR page. `day` = the school day (Riyadh,
/// YYYY-MM-DD): the name stays off the list for the rest of that day (also on a re-opened QR) until the teacher
/// signs the student out or lets them in again (signedOutAt).
model ClassSignInUse {
  id          String    @id @default(cuid())
  signInId    String
  schoolId    String
  classId     String
  studentId   String
  userId      String
  day         String    @db.VarChar(10)
  createdAt   DateTime  @default(now())
  signedOutAt DateTime?

  @@index([classId, day])
  @@index([studentId, day])
}

/// r85: a class's PRINTABLE QR (weekly plan sheet) + its 4-digit class code. One row per class. The QR link carries a
/// 256-bit token = HMAC(APP_SECRET, linkSalt): only its SHA-256 (tokenHash) is stored, and the server can draw the same
/// QR again for the class's teacher. "New link" = a new linkSalt (old printed QRs die). `code` is read only by the
/// teacher's pages (and compared on the server at sign-in); it is never sent to a student page.
model ClassPrintQr {
  id            String    @id @default(cuid())
  schoolId      String
  classId       String    @unique
  linkSalt      String    @db.VarChar(64)
  tokenHash     String    @unique @db.VarChar(64)
  code          String    @db.VarChar(4)
  active        Boolean   @default(true)
  createdById   String // User.id of the teacher who turned it on first
  codeChangedAt DateTime
  linkChangedAt DateTime
  turnedOffAt   DateTime?
  createdAt     DateTime  @default(now())
}

/// r85: a student who signed in from the class's printed QR (+ class code) — at school or at home. Every sign-in is a
/// row (no once-a-day rule); the teacher sees today / this week.
model ClassPrintSignIn {
  id        String   @id @default(cuid())
  printQrId String
  schoolId  String
  classId   String
  studentId String
  userId    String
  day       String   @db.VarChar(10)
  createdAt DateTime @default(now())

  @@index([classId, createdAt])
  @@index([studentId, createdAt])
}

/// Fine-grained permission grants on top of the role (e.g. a teacher allowed to edit the question bank).
model RolePermission {
  id         String @id @default(cuid())
  role       Role
  permission String // e.g. "questions:publish"

  @@unique([role, permission])
}

// --------------------------------------------------------- organisation ----

model School {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  logoUrl   String?
  timezone  String    @default("Asia/Riyadh")
  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users         User[]
  academicYears AcademicYear[]
  grades        Grade[]
  classes       Class[]
  students      Student[]
  teachers      Teacher[]
  settings      SchoolSetting[]
}

/// Configurable engine settings (mastery thresholds, adaptive parameters) per school, JSON-validated in code.
model SchoolSetting {
  id        String   @id @default(cuid())
  schoolId  String
  key       String // "mastery.thresholds" | "adaptive.engine" | "gamification"
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, key])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  school  School  @relation(fields: [schoolId], references: [id])
  terms   Term[]
  classes Class[]

  @@unique([schoolId, name])
}

model Term {
  id             String   @id @default(cuid())
  academicYearId String
  name           String // "Term 1"
  startDate      DateTime
  endDate        DateTime

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([academicYearId, name])
}

/// Grade level. `level` is numeric (1-12) so new grades are rows, not code changes.
model Grade {
  id       String @id @default(cuid())
  schoolId String
  level    Int
  name     String // "Grade 4"
  isActive Boolean @default(true) // admins can deactivate a grade (hidden from teachers, students, editors)

  school      School       @relation(fields: [schoolId], references: [id])
  classes     Class[]
  curricula   Curriculum[]
  students    Student[]

  @@unique([schoolId, level])
  mapNodes      CurriculumMapNode[]
}

model Class {
  id             String    @id @default(cuid())
  schoolId       String
  gradeId        String
  academicYearId String
  name           String // "4A"
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  school       School            @relation(fields: [schoolId], references: [id])
  grade        Grade             @relation(fields: [gradeId], references: [id])
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id])
  memberships  ClassMembership[]
  teachers     ClassTeacher[]
  assignments  Assignment[]
  skillDaily   ClassSkillDaily[]

  @@unique([academicYearId, name])
  @@index([gradeId])
}

model Teacher {
  id       String @id @default(cuid())
  userId   String @unique
  schoolId String
  title    String? // "Miss", "Mr."

  user    User           @relation(fields: [userId], references: [id])
  school  School         @relation(fields: [schoolId], references: [id])
  classes ClassTeacher[]
  assignmentsCreated Assignment[]
}

model ClassTeacher {
  classId   String
  teacherId String
  isLead    Boolean @default(true)

  class   Class   @relation(fields: [classId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@id([classId, teacherId])
  @@index([teacherId])
}

model Student {
  id               String    @id @default(cuid())
  userId           String    @unique
  schoolId         String
  gradeId          String
  studentNumber    String // school-issued id; no national ID stored (data minimisation)
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  user              User                    @relation(fields: [userId], references: [id])
  school            School                  @relation(fields: [schoolId], references: [id])
  grade             Grade                   @relation(fields: [gradeId], references: [id])
  memberships       ClassMembership[]
  parents           ParentStudent[]
  sessions          PracticeSession[]
  attempts          QuestionAttempt[]
  mastery           StudentSkillMastery[]
  abilities         StudentAbility[]
  abilitySnapshots  AbilitySnapshot[]
  readingRange      StudentReadingRange[]
  assignments       AssignmentStudent[]
  mapResults        MapResult[]
  externalResults   ExternalAssessmentResult[]
  recommendations   Recommendation[]
  badges            StudentBadge[]
  xpEvents          XpEvent[]
  adaptiveLogs      AdaptiveDecisionLog[]
  interventionAlerts InterventionAlert[]
  dailyActivity     StudentDailyActivity[]
  diagnostics       DiagnosticResult[]

  @@unique([schoolId, studentNumber])
  @@index([gradeId])
}

model ClassMembership {
  classId   String
  studentId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  class   Class   @relation(fields: [classId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@id([classId, studentId])
  @@index([studentId])
}

model Parent {
  id     String @id @default(cuid())
  userId String @unique

  user     User            @relation(fields: [userId], references: [id])
  children ParentStudent[]
}

model ParentStudent {
  parentId     String
  studentId    String
  relationship String? // "mother", "father", "guardian"

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@id([parentId, studentId])
  @@index([studentId])
}

// ----------------------------------------------------------- curriculum ----

/// Publisher programme (Wonders, StudySync). Edition stored explicitly (uploaded books are 2023).
model Book {
  id        String  @id @default(cuid())
  code      String  @unique // "WONDERS-G4"
  title     String
  publisher String?
  edition   String?

  curricula Curriculum[]
  mapNodes      CurriculumMapNode[]
}

/// A grade's instance of a book at a school: Grade 4 + Wonders. Mastery is tracked per curriculum skill.
model Curriculum {
  id       String    @id @default(cuid())
  gradeId  String
  bookId   String
  name     String // "Grade 4 · Wonders"
  isActive Boolean   @default(true)
  deletedAt DateTime?

  grade  Grade   @relation(fields: [gradeId], references: [id])
  book   Book    @relation(fields: [bookId], references: [id])
  units  Unit[]
  skills Skill[]

  @@unique([gradeId, bookId])
}

model Unit {
  id           String    @id @default(cuid())
  curriculumId String
  number       Int
  title        String
  description  String?   @db.Text
  isActive     Boolean   @default(true)
  deletedAt    DateTime?

  curriculum  Curriculum   @relation(fields: [curriculumId], references: [id])
  lessons     Lesson[]
  unitSkills  UnitSkill[]
  assignments Assignment[]
  assessments Assessment[]

  @@unique([curriculumId, number])
}

/// Wonders: a Text Set (weeks 1-2, 3-4, 5). StudySync: a selection / lesson.
model Lesson {
  id        String    @id @default(cuid())
  unitId    String
  number    Int
  code      String // "G4-U1-TS1" — unique within a unit (several schools can share a curriculum)
  title     String
  genre     String?
  weeks     Json? // [1,2]
  texts     Json? // {shared_read, anchor_text, paired_selection} — titles only
  metadata  Json? // vocabulary words, assessed focus labels
  deletedAt DateTime?

  unit         Unit          @relation(fields: [unitId], references: [id])
  lessonSkills LessonSkill[]
  questions    Question[]

  @@unique([unitId, number])
  @@unique([unitId, code])
}

/// Cross-grade skill concept: the node of the learning continuum ("Theme", "Context Clues").
model SkillFamily {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  domain      Domain
  category    SkillCategory
  mapGoalAreaId String?

  mapGoalArea MapGoalArea? @relation(fields: [mapGoalAreaId], references: [id])
  skills      Skill[]
}

/// Grade-specific skill inside a curriculum. Mastery and theta are tracked at this level.
model Skill {
  id           String        @id @default(cuid())
  curriculumId String
  familyId     String
  code         String // "G4.context-clues"
  name         String
  description  String?       @db.Text
  domain       Domain
  category     SkillCategory
  sequence     Int           @default(0) // curriculum order for recommendations
  isActive     Boolean       @default(true)
  deletedAt    DateTime?

  curriculum     Curriculum          @relation(fields: [curriculumId], references: [id])
  family         SkillFamily         @relation(fields: [familyId], references: [id])
  subskills      Subskill[]
  standards      SkillStandard[]
  prerequisites  SkillPrerequisite[] @relation("SkillHasPrereq")
  dependents     SkillPrerequisite[] @relation("PrereqOfSkill")
  lessonSkills   LessonSkill[]
  unitSkills     UnitSkill[]
  questions      Question[]
  mastery        StudentSkillMastery[]
  abilities      StudentAbility[]
  externalRefs   ExternalSkillRef[]
  attempts       QuestionAttempt[]
  classDaily     ClassSkillDaily[]

  @@unique([curriculumId, code])
  @@index([familyId])
  @@index([domain])
}

model Subskill {
  id        String    @id @default(cuid())
  skillId   String
  code      String
  name      String
  content   Json? // rule summaries, word lists (spelling) — reference data, not questions
  deletedAt DateTime?

  skill     Skill      @relation(fields: [skillId], references: [id])
  questions Question[]

  @@unique([skillId, code])
}

/// Where a skill is taught (one skill can appear in several lessons/units).
model LessonSkill {
  lessonId   String
  skillId    String
  subskillId String?
  role       SkillRole
  label      String // label as printed in the book

  lesson Lesson @relation(fields: [lessonId], references: [id])
  skill  Skill  @relation(fields: [skillId], references: [id])

  @@id([lessonId, skillId, label])
  @@index([skillId])
}

/// Unit-level skill pool (used directly for StudySync, derived from lessons for Wonders).
model UnitSkill {
  unitId  String
  skillId String
  order   Int    @default(0)

  unit  Unit  @relation(fields: [unitId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([unitId, skillId])
  @@index([skillId])
}

model Standard {
  id          String            @id @default(cuid())
  framework   StandardFramework
  code        String
  description String?           @db.Text
  gradeLevel  Int?
  strand      String?
  isActive    Boolean           @default(true)

  skills    SkillStandard[]
  questions Question[]

  @@unique([framework, code])
}

/// Many-to-many: one skill -> CCSS + curriculum map + MAP continuum + school objective.
model SkillStandard {
  skillId    String
  standardId String
  isPrimary  Boolean @default(false)

  skill    Skill    @relation(fields: [skillId], references: [id])
  standard Standard @relation(fields: [standardId], references: [id])

  @@id([skillId, standardId])
  @@index([standardId])
}

/// MAP Growth Learning Continuum: what a student in a RIT band is ready to learn (imported by an admin from
/// the school's own continuum file); linked to the platform's skills through the CCSS codes.
model LearningStatement {
  id         String   @id @default(cuid())
  /// READING | LANGUAGE
  subject    String   @db.VarChar(10)
  ritLow     Int
  ritHigh    Int
  goalArea   String   @db.VarChar(120)
  topic      String   @db.VarChar(120)
  statement  String   @db.Text
  /// CCSS codes separated by spaces, e.g. "RL.4.2 RL.5.2"
  standards  String   @db.VarChar(500)
  sortOrder  Int      @default(0)
  importedAt DateTime @default(now())

  @@index([subject, ritLow])
}

/// MAP-style goal areas (names only, matching the school's MAP skills documents).
model MapGoalArea {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  subject  String // READING | LANGUAGE_USAGE

  families   SkillFamily[]
  mapResults MapResult[]
}

model SkillPrerequisite {
  skillId             String
  prerequisiteSkillId String
  weight              Float  @default(0.5) // 0-1 strength of dependency
  minimumMastery      Int    @default(60)

  skill        Skill @relation("SkillHasPrereq", fields: [skillId], references: [id])
  prerequisite Skill @relation("PrereqOfSkill", fields: [prerequisiteSkillId], references: [id])

  @@id([skillId, prerequisiteSkillId])
  @@index([prerequisiteSkillId])
}

// ---------------------------------------------------------- question bank ----

model ReadingPassage {
  id                    String        @id @default(cuid())
  externalRef           String?       @unique // stable id from the bank / import file
  title                 String
  body                  String        @db.MediumText
  genre                 String?
  gradeBand             String? // "4-5"
  wordCount             Int
  sentenceCount         Int
  avgSentenceLength     Float
  avgWordLength         Float
  gradeLevel            Int?
  platformReadingLevel  Int? // PRL — INTERNAL measure, never a Lexile; null for poetry/drama (prose formula not valid)
  estimatedDifficulty   Float? // b-scale
  status                ContentStatus @default(DRAFT)
  origin                ContentOrigin @default(TEACHER_AUTHORED)
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  officialMeasures OfficialReadingMeasure[]
  questions        Question[]

  @@index([platformReadingLevel])
}

/// Externally licensed reading measures (e.g. an official Lexile) — stored separately from PRL.
model OfficialReadingMeasure {
  id          String   @id @default(cuid())
  passageId   String
  provider    String // "Lexile" — only from an authorised source
  value       String
  sourceRef   String?
  importedAt  DateTime @default(now())

  passage ReadingPassage @relation(fields: [passageId], references: [id])
}

/// Question types are data, not an enum, so new formats are added without a migration.
model QuestionType {
  id          String  @id @default(cuid())
  code        String  @unique // MULTIPLE_CHOICE, MULTI_SELECT, TRUE_FALSE, FILL_BLANK, DROPDOWN, MATCHING, DRAG_DROP, SENTENCE_ORDER, WORD_ORDER, ERROR_CORRECTION, SHORT_ANSWER
  name        String
  isAutoScored Boolean @default(true)
  schema      Json? // JSON schema for the `content` payload

  questions Question[]
}

model Question {
  id              String         @id @default(cuid())
  externalRef     String? // id from the bank / bulk import file — unique per skill (each school has its own skills)
  skillId         String
  subskillId      String?
  lessonId        String?
  passageId       String?
  imageId          String? // optional QuestionImage
  standardId      String? // the standard this item primarily assesses
  typeId          String
  stem            String         @db.Text
  content         Json // type-specific payload (blanks, pairs, tokens…)
  hint            String?        @db.Text
  difficultyLevel Int // 1-7 authoring level
  irtA            Float          @default(1.0) // discrimination
  irtB            Float // difficulty on theta scale (seeded from level)
  irtC            Float          @default(0.0) // guessing (3PL-ready)
  calibrated      Boolean        @default(false) // true once b/a estimated from data
  estimatedSeconds Int           @default(45)
  tags            Json?
  status          ContentStatus  @default(DRAFT)
  origin          ContentOrigin  @default(TEACHER_AUTHORED)
  aiStatus        AiReviewStatus?
  version         Int            @default(1)
  createdById     String?
  reviewedById    String?
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  skill        Skill                 @relation(fields: [skillId], references: [id])
  subskill     Subskill?             @relation(fields: [subskillId], references: [id])
  lesson       Lesson?               @relation(fields: [lessonId], references: [id])
  passage      ReadingPassage?       @relation(fields: [passageId], references: [id])
  standard     Standard?             @relation(fields: [standardId], references: [id])
  type         QuestionType          @relation(fields: [typeId], references: [id])
  options      QuestionOption[]
  answers      QuestionAnswer[]
  explanations QuestionExplanation[]
  attempts     QuestionAttempt[]
  assessmentQuestions AssessmentQuestion[]
  stats        QuestionStats?

  @@unique([skillId, externalRef])
  @@index([skillId, status, irtB])
  // ⚡ a skill's published / live questions by level, and the per-skill counts (GROUP BY skillId) read from the index alone
  @@index([skillId, deletedAt, status, difficultyLevel])
  @@index([status, origin])
  @@index([standardId])
  mapLinks              QuestionMapLink[]
  uses                  QuestionUse[]
  /// text complexity of the question (or its passage), e.g. 820 for 820L; drives Below / On / Above
  lexile                Int?
  /// NWEA MAP Growth: the test ("Reading" | "Language Usage") and the instructional area, e.g. "Literary Text",
  /// "Language: Understand, Edit for Mechanics"; how it was decided: IMPORT · ADMIN · SKILL · STANDARD ·
  /// SKILL_STANDARD · CATEGORY · TEXT · AI
  mapTest               String?  @db.VarChar(20)
  mapInstructionalArea  String?  @db.VarChar(80)
  mapAreaSource         String?  @db.VarChar(16)

  @@index([mapInstructionalArea, status])
  /// 🧠 question intelligence (src/questions/intelligence.ts): Depth of Knowledge 1–4 and how it was set (RULE · AI · ADMIN · IMPORT);
  /// the difficulty estimated before any student data (level 1–7, IRT b, the five factors); where the difficulty in use
  /// comes from (AUTHORED · ESTIMATE · CALIBRATED); the text complexity (Lexile-like estimate); when it was analysed
  dok                   Int?
  dokSource             String?  @db.VarChar(8)
  estimatedLevel        Int?
  estimatedB            Float?
  difficultyFactors     Json?
  difficultySource      String?  @db.VarChar(12)
  textLevel             Int?
  intelligenceAt        DateTime?
  metaReviewedAt        DateTime?

  @@index([intelligenceAt])
  /// 👯 fingerprint of the content (normalized stem + choices + key + type + passage): exact duplicates share it
  /// (src/server/questions/dedupe-hash.ts). Indexed so the importer and the editor find duplicates by lookup.
  contentHash           String?  @db.VarChar(64)

  @@index([contentHash])
  @@index([status, updatedAt])
  /// ✏️ a teacher's own edited copy of a question (src/server/tests/review.ts): PRIVATE to that teacher (their User id).
  /// Never in the shared bank's lists, pools or counts (src/server/questions/private-copies.ts); null = a shared question.
  privateToId           String?  @db.VarChar(191)

  /// ⚡ the shared bank's per-skill reads and counts (privateToId IS NULL) answered from the index alone, as before
  @@index([skillId, deletedAt, status, privateToId, difficultyLevel])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  label      String // "A"
  text       String  @db.Text
  isCorrect  Boolean @default(false)
  rationale  String? @db.Text // why this distractor is wrong
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  /// misconception code for a wrong option (e.g. DETAIL_NOT_MAIN), see src/insights/misconceptions.ts; how it was set: RULE | AI | ADMIN
  misconception      String?  @db.VarChar(40)
  misconceptionSource String? @db.VarChar(8)
}

/// Accepted answers for non-option types (fill-in, short answer, ordering keys).
model QuestionAnswer {
  id         String  @id @default(cuid())
  questionId String
  value      Json
  isPrimary  Boolean @default(true)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionExplanation {
  id         String  @id @default(cuid())
  questionId String
  kind       String // "WHY_CORRECT" | "RULE" | "EXAMPLE" | "TIP"
  body       Json // rich content blocks: text, highlight, table, image
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

/// Rolling item statistics for item analysis (recomputed by a background job).
model QuestionStats {
  questionId         String   @id
  attempts           Int      @default(0)
  correct            Int      @default(0)
  pValue             Float? // proportion correct
  pointBiserial      Float? // discrimination proxy
  avgResponseMs      Int?
  distractorCounts   Json?
  flags              Json? // ["TOO_EASY","DISTRACTOR_NEVER_CHOSEN",...]
  updatedAt          DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
}

// -------------------------------------------------- practice & attempts ----

model PracticeSession {
  id           String      @id @default(cuid())
  studentId    String
  skillId      String?
  assessmentId String?
  assignmentId String?
  mode         SessionMode
  startedAt    DateTime    @default(now())
  endedAt      DateTime?
  questionCount Int        @default(0)
  correctCount Int         @default(0)
  activeMs     Int         @default(0)
  // the question currently shown: answers are only accepted for this question, timed from servedAt
  currentQuestionId String?
  currentServedAt   DateTime?
  currentOrder      Json? // shuffled presentation order (ordering/matching), to map the student's answer back
  lastTargetB       Float?
  endReason         String? // COMPLETED | POOL_EXHAUSTED | PREREQ_ROUTE | STUDENT_EXIT | TIMEOUT

  student    Student           @relation(fields: [studentId], references: [id])
  assessment Assessment?       @relation(fields: [assessmentId], references: [id])
  attempts   QuestionAttempt[]

  @@index([studentId, startedAt])
  @@index([startedAt]) // admin home: students active in the last 7 days (Update 46)
  @@index([assignmentId])
  /// when the set's goal (correct answers) was reached; the student may go on practising
  goalReachedAt DateTime?
  /// the question the student asked a hint for (set by the server when the hint is shown; the answer then counts half)
  hintQuestionId    String?
  /// r67 guessing: answers of this session that were rapid guesses (effort = 1 − guessCount / questionCount)
  guessCount        Int      @default(0)
  /// r67 effort: more than 20 % of the answers were rapid guesses — teacher-only "Unreliable"; its answers never
  /// change the student's level, tier or intervention plan
  unreliable        Boolean  @default(false)
}

model QuestionAttempt {
  id             BigInt   @id @default(autoincrement())
  sessionId      String
  studentId      String
  questionId     String
  skillId        String
  response       Json
  isCorrect      Boolean
  partialCredit  Float? // 0-1 for multi-part items
  responseMs     Int
  usedHint       Boolean  @default(false)
  rapidGuess     Boolean  @default(false)
  difficultyB    Float // item b at time of answer (frozen for audit)
  createdAt      DateTime @default(now())

  session  PracticeSession @relation(fields: [sessionId], references: [id])
  student  Student         @relation(fields: [studentId], references: [id])
  question Question        @relation(fields: [questionId], references: [id])
  skill    Skill           @relation(fields: [skillId], references: [id])

  @@index([studentId, skillId, createdAt])
  @@index([studentId, createdAt]) // analytics: a group's answers in a date range (performance)
  @@index([questionId, createdAt])
  @@index([skillId, createdAt])
  // every answer reads the attempts of its session (sets, tests): without this the table is scanned
  @@index([sessionId])
  /// the misconception of the wrong option the student chose (copied at answer time, so reports need no joins)
  misconception  String?  @db.VarChar(40)
  /// where the answer came from (Update 39B, for reports): null = practice / assigned sets / checks · LESSON ·
  /// REVIEW (Review my mistakes) · READMASTER · GAME (live game)
  source         String?  @db.VarChar(12)
  /// r67 effort: the answer belongs to a session marked Unreliable (> 20 % rapid guesses): left out of level, tier
  /// and intervention decisions (the session's flag copied to its answers, so those readers need no join)
  unreliable     Boolean  @default(false)

  @@index([studentId, misconception])
}

/// Every adaptive decision, fully traceable.
model AdaptiveDecisionLog {
  id                  BigInt   @id @default(autoincrement())
  studentId           String
  sessionId           String
  attemptId           BigInt?
  questionId          String?
  skillId             String
  previousTheta       Float
  newTheta            Float
  thetaSE             Float
  questionDifficulty  Float?
  responseCorrect     Boolean?
  responseMs          Int?
  masteryBefore       Float?
  masteryAfter        Float?
  nextQuestionId      String?
  nextTargetB         Float?
  reason              String   @db.Text // human-readable
  reasonCode          String // TARGET_SUCCESS_RATE | STEP_DOWN | PREREQ_ROUTE | ...
  engineVersion       String
  createdAt           DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
  @@index([sessionId])
  @@index([questionId])
  @@index([attemptId])
}

/// Current internal ability estimate per student x skill (and a per-domain/global row with skillId null).
model StudentAbility {
  id         String   @id @default(cuid())
  studentId  String
  scope      String // "GLOBAL" | "DOMAIN:READING" | "SKILL:<skillId>" — non-null so the unique key works in MySQL
  skillId    String?
  domain     Domain?
  theta      Float    @default(0)
  thetaSE    Float    @default(1)
  responses  Int      @default(0)
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  skill   Skill?  @relation(fields: [skillId], references: [id])

  @@unique([studentId, scope])
  @@index([skillId])
}

/// Daily snapshot for growth charts (internal metric).
model AbilitySnapshot {
  id         BigInt   @id @default(autoincrement())
  studentId  String
  scope      String // "GLOBAL" | "DOMAIN:READING" | "SKILL:<id>"
  theta      Float
  mastery    Float?
  takenOn    DateTime @db.Date

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, scope, takenOn])
  @@index([takenOn])
}

model StudentSkillMastery {
  studentId       String
  skillId         String
  score           Float       @default(0) // 0-100 INTERNAL mastery
  band            MasteryBand @default(BEGINNING)
  attempts        Int         @default(0)
  correct         Int         @default(0)
  maxLevelCorrect Int         @default(0)
  isMastered      Boolean     @default(false)
  masteredAt      DateTime?
  lastPracticedAt DateTime?
  components      Json? // breakdown for transparency
  updatedAt       DateTime    @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@id([studentId, skillId])
  @@index([skillId, band])
  /// spaced review of a mastered skill: when it is due and which step (0 = 2 weeks, 1 = 6 weeks, 2+ = 12 weeks)
  nextReviewAt    DateTime?
  reviewStep      Int         @default(0)
}

model ReadingLevelBand {
  id      String @id @default(cuid())
  label   String // "PRL 500-599"
  minPrl  Int
  maxPrl  Int
  gradeBand String?
}

/// Internal Platform Reading Range history.
model StudentReadingRange {
  id        String   @id @default(cuid())
  studentId String
  lowPrl    Int
  highPrl   Int
  evidence  Int // passage responses used
  computedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, computedAt])
}

// ------------------------------------------------ assignments & assessment ----

model Assignment {
  id          String           @id @default(cuid())
  classId     String
  createdById String
  title       String
  target      AssignmentTarget
  unitId      String?
  skillIds    Json? // for SKILL assignments
  skillId     String? // one skill per assignment (Assign button); skillIds kept for older rows
  startAt     DateTime?
  note        String?          @db.Text
  /// CURRICULUM (taught from the book units) or MAP (MAP Growth preparation); shown as two areas to students
  track        String   @default("CURRICULUM") @db.VarChar(16)
  /// the program the work belongs to (e.g. CURRICULUM for plans sent from the Curriculum Map); null = older rows
  program      String?  @db.VarChar(16)
  assessmentId String?
  targetMastery Int?           // e.g. 75
  /// a full-curriculum plan's place: opened by a student, hidden from the work lists (shown in the plan)
  curriculumPlanId String?
  dueAt       DateTime?
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  /// UI reorg Phase 5: the teacher-built test (TeacherTest) this assignment belongs to
  testId      String?
  /// UI reorg Phase 5: question order and answer choices shuffled per student (deterministic)
  shuffle     Boolean          @default(false)
  /// the questions the teacher picked ("I'll pick the questions"); null = the platform chooses for each student
  questionIds Json?
  /// r67: the number of questions the teacher set for skill work (each student answers exactly this many counted
  /// answers); null = the 30–50 rule
  questionCount Int?
  /// r74 (owner): where the work comes from — MAP | NAFS | CURRICULUM | GRAMMAR | RTI, chosen on every assign window
  /// (required for new work); null = older rows (the source is inferred for display: lib/assign-source.ts)
  source        String?  @db.VarChar(16)

  class      Class               @relation(fields: [classId], references: [id])
  createdBy  Teacher             @relation(fields: [createdById], references: [id])
  unit       Unit?               @relation(fields: [unitId], references: [id])
  assessment Assessment?         @relation(fields: [assessmentId], references: [id])
  students   AssignmentStudent[]

  @@index([classId, dueAt])
  @@index([skillId])
  @@index([testId])
}

model AssignmentStudent {
  assignmentId String
  studentId    String
  status       AssignmentStatus @default(NOT_STARTED)
  progress     Float            @default(0)
  completedAt  DateTime?
  /// skill work: answers counted for the assignment's core result (the FIRST 25 answers; frozen at 25)
  coreAnswered Int?
  /// skill work: correct answers among those first answers (accuracy = coreCorrect / coreAnswered)
  coreCorrect  Int?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@id([assignmentId, studentId])
  @@index([studentId, status])
}

model Assessment {
  id           String         @id @default(cuid())
  title        String
  type         AssessmentType
  unitId       String?
  isAdaptive   Boolean        @default(false)
  maxQuestions Int?
  /// adaptive sets: done after this many correct answers (the student may keep practising after it)
  targetCorrect Int?
  timeLimitMin Int?
  status       ContentStatus  @default(DRAFT)
  createdById  String?
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?

  unit        Unit?                @relation(fields: [unitId], references: [id])
  questions   AssessmentQuestion[]
  sessions    PracticeSession[]
  assignments Assignment[]
}

model AssessmentQuestion {
  assessmentId String
  questionId   String
  order        Int
  points       Float  @default(1)

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  question   Question   @relation(fields: [questionId], references: [id])

  @@id([assessmentId, questionId])
}

// ------------------------------------------------ external / official data ----

model ExternalAssessmentSource {
  id       String @id @default(cuid())
  code     String @unique // "NWEA_MAP" | "IXL" | ...
  name     String
  notes    String? @db.Text

  results  ExternalAssessmentResult[]
  skillRefs ExternalSkillRef[]
}

/// Maps an external skill name/code (e.g. IXL "LQN") to a platform skill. Names only — no content.
model ExternalSkillRef {
