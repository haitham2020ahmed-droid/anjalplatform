/// 📨 A message (or a report link) the school admin sent to teachers: in the platform and by email.
model AdminMessage {
  id          String   @id @default(cuid())
  schoolId    String
  senderId    String
  subject     String   @db.VarChar(150)
  body        String   @db.Text
  /// optional platform page the teacher can open (a report)
  link        String?  @db.VarChar(300)
  /// { kind: ALL | GRADE | SELECTED, grades?, userIds? }
  audience    Json
  recipients  Int      @default(0)
  emailed     Int      @default(0)
  emailFailed Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([schoolId, createdAt])
}

model AdminMessageRecipient {
  id             String    @id @default(cuid())
  messageId      String
  userId         String
  notificationId String?
  /// SENT | FAILED | NO_EMAIL | OFF
  emailStatus    String    @db.VarChar(10)
  readAt         DateTime?

  @@unique([messageId, userId])
  @@index([userId])
}

/// 🧭 The student's current support tier (RTI/MTSS): 1 core · 2 small group · 3 intensive. Changed automatically by
/// the daily rules (the teacher can override and lock it).
model StudentTier {
  studentId    String   @id
  schoolId     String
  tier         Int      @default(1)
  /// AUTO | TEACHER
  source       String   @default("AUTO") @db.VarChar(8)
  /// a teacher's choice that the daily rules must not change
  locked       Boolean  @default(false)
  reason       String   @db.Text
  /// the skill the support is for, when there is one
  focusSkillId String?
  since        DateTime @default(now())
  reviewAt     DateTime?
  /// how often progress is checked: days between checks (Tier 1: 0 = 3 times a year)
  monitorEveryDays Int  @default(0)
  updatedAt    DateTime @updatedAt

  @@index([schoolId, tier])
}

model TierChange {
  id         String   @id @default(cuid())
  studentId  String
  schoolId   String
  fromTier   Int
  toTier     Int
  source     String   @db.VarChar(8)
  reason     String   @db.Text
  /// the evidence behind it (scores, dates)
  evidence   Json?
  changedById String?
  createdAt  DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([schoolId, createdAt])
}

/// 🗂️ A data meeting: what changed since the last one and the decisions (who · what · how · owner · review date).
model DataMeeting {
  id         String   @id @default(cuid())
  schoolId   String
  classId    String?
  /// grade-team meeting when classId is null
  gradeLevel Int?
  heldOn     DateTime
  createdById String
  /// the snapshot the platform prepared (changes, tiers, weak skills, interventions)
  snapshot   Json
  /// [{ who, what, how, owner, reviewOn }]
  decisions  Json
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([schoolId, heldOn])
  @@index([classId, heldOn])
}


// ------------------------------------------------------ update 37 ----

/// 🔤 Decoding (phonics) screener: the student hears a word and picks its spelling, real and made-up words,
/// 8 strands from short vowels to multisyllable words. 80% per strand = mastered; more than one miss = reteach.
model DecodingScreen {
  id          String    @id @default(cuid())
  studentId   String
  schoolId    String
  /// who asked for it: TEACHER | TIER (both comprehension and fluency low) | SELF
  reason      String    @default("TEACHER") @db.VarChar(8)
  /// [{ strand, items:[{ word, real, choices, answer, picked, correct }] }]
  items       Json
  /// { strand: { correct, total, pct, status: MASTERED | REVIEW | RETEACH } }
  result      Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([studentId, startedAt])
  @@index([schoolId, completedAt])
}

/// 📋 A short progress check at the end of a text set (a curriculum lesson): ~10 items on the skills just taught,
/// Comprehension and Vocabulary subscores, 80% to pass (Wonders-style model, original items from the bank).
model ProgressCheck {
  id           String   @id @default(cuid())
  schoolId     String
  classId      String
  lessonId     String
  assignmentId String
  title        String   @db.VarChar(191)
  /// { questionId: "COMPREHENSION" | "VOCABULARY" | "OTHER" }
  categories   Json
  createdById  String
  createdAt    DateTime @default(now())

  @@unique([assignmentId])
  @@index([classId, createdAt])
}

/// 🧠 Metacomprehension survey: which reading strategies a student says they use (before / during / after) —
/// used for strategy groups, never for placement.
model StrategySurvey {
  id          String   @id @default(cuid())
  studentId   String
  schoolId    String
  /// { itemId: choiceIndex }
  answers     Json
  /// { BEFORE: 0–100, DURING: 0–100, AFTER: 0–100, weakStrategies: [] }
  result      Json
  createdAt   DateTime @default(now())

  @@index([studentId, createdAt])
}


// ------------------------------------------------------ update 38 ----

/// 🧩 An interactive intervention lesson on one skill (gradual release): MODEL (worked example + think-aloud) →
/// GUIDED (items with highlighted clues and a hint ladder) → INDEPENDENT → CHECK (80% to pass). A failed check goes
/// back one phase with a different approach (organizer / sentence frames / easier text), never the same one again.
model LessonRun {
  id         String    @id @default(cuid())
  studentId  String
  schoolId   String
  skillId    String
  /// who started it: STUDENT | TEACHER | TIER | ASSIGNMENT
  source     String    @default("STUDENT") @db.VarChar(10)
  /// MODEL | GUIDED | INDEPENDENT | CHECK | DONE
  phase      String    @default("MODEL") @db.VarChar(12)
  /// how many times the check was tried, and which alternate approach is in use (0 = standard)
  attempts   Int       @default(0)
  approach   Int       @default(0)
  /// [{ phase, questionId, correct, hints, at }]
  log        Json
  /// the organizer the student filled in (structure skills)
  organizer  Json?
  checkPct   Int?
  passed     Boolean?
  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([studentId, skillId])
  @@index([schoolId, updatedAt])
}

// ------------------------------------------------------ ReadRise ----
// 🚀 ReadRise: an independent nonfiction reading tool (separate from ReadMaster and the curriculum). Each article is
// written at 12 levels (300–1400 on the ReadRise Level scale — an estimate on a Lexile-like scale, NOT an official
// Lexile measure unless officialLexile is filled from a licensed analyzer). Every student has a personal level that
// rises or falls with quiz scores. 5-step routine: pre-poll · read · 8 questions · short written answer · post-poll.

model RRArticle {
  id          String    @id @default(cuid())
  /// null = the platform library (every school); else a school's own article
  schoolId    String?
  code        String    @db.VarChar(40)
  title       String    @db.VarChar(191)
  topic       String    @db.VarChar(60)
  summary     String?   @db.VarChar(400)
  /// the poll statement students agree/disagree with before and after reading
  pollStatement String  @db.VarChar(300)
  /// DRAFT | PUBLISHED
  status      String    @default("DRAFT") @db.VarChar(10)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([schoolId, status])
  @@index([code])
}

model RRVersion {
  id         String  @id @default(cuid())
  articleId  String
  /// the ReadRise Level of this version: 300, 400 … 1400
  level      Int
  title      String  @db.VarChar(191)
  body       String  @db.Text
  wordCount  Int
  /// the platform's estimate of the text's level (checks the writer hit the target)
  estLevel   Int
  /// an official Lexile measure, when the school has a licensed analyzer
  officialLexile Int?

  @@unique([articleId, level])
}

model RRQuestion {
  id        String @id @default(cuid())
  articleId String
  /// LOW (300–600) | MID (700–1000) | HIGH (1100–1400)
  band      String @db.VarChar(4)
  number    Int
  stem      String @db.Text
  /// ["…","…","…","…"]
  options   Json
  /// A | B | C | D
  answer    String @db.VarChar(1)
  /// central-idea | detail | inference | vocabulary | text-structure | author-purpose | cause-effect | sequence | compare
  skill     String @db.VarChar(30)
  /// { A: "why…", … }
  rationale Json?

  @@unique([articleId, band, number])
}

model RRPrompt {
  id        String @id @default(cuid())
  articleId String
  band      String @db.VarChar(4)
  prompt    String @db.Text
  /// what a strong answer includes (shown to the student as a checklist, used by the teacher when scoring)
  checklist Json?
  /// 5 key words taught before reading: [{ word, partOfSpeech, definition, example }]
  keyWords  Json?
  /// ✍️ owner r##: a curated model (strong) answer to the writing prompt — shown to the student only AFTER they
  /// submit their own writing (never before), so they see a strong example to compare against, not a script to copy
  modelAnswer String? @db.Text

  @@unique([articleId, band])
}

/// the student's personal ReadRise Level
model RRStudent {
  studentId    String   @id
  schoolId     String
  level        Int
  startLevel   Int
  /// PLACEMENT | MAP | DEFAULT | TEACHER
  source       String   @db.VarChar(10)
  placedAt     DateTime @default(now())
  articlesDone Int      @default(0)
  /// weekly goal: articles per week at 75%+ on the first try (Achieve3000-style usage goal)
  weeklyGoal   Int      @default(2)
  updatedAt    DateTime @updatedAt

  @@index([schoolId])
}

model RRLevelChange {
  id        String   @id @default(cuid())
  studentId String
  schoolId  String
  fromLevel Int
  toLevel   Int
  reason    String   @db.VarChar(300)
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([schoolId, createdAt])
}

/// one student's work on one article (the 5 steps)
model RRRun {
  id           String    @id @default(cuid())
  studentId    String
  schoolId     String
  articleId    String
  /// the version shown (its level) and the question band used
  versionLevel Int
  band         String    @db.VarChar(4)
  /// PREPOLL | READ | QUIZ | WRITE | POSTPOLL | DONE
  step         String    @default("PREPOLL") @db.VarChar(8)
  /// 0 strongly agree … 3 strongly disagree
  prePoll      Int?
  postPoll     Int?
  readSeconds  Int?
  /// { "1": "B", … }
  answers      Json?
  /// % correct of the 8 questions
  score        Int?
  writing      String?   @db.Text
  /// 0–4, by the teacher
  writingScore Int?
  writingComment String? @db.VarChar(1000)
  writingScoredById String?
  /// 🤖 owner r##: an AI-drafted score + comment, saved right after the student submits (never shown to the
  /// student) — the teacher's scoring screen pre-fills from these so they can accept or edit before saving the
  /// real writingScore/writingComment. Never written again once writingScore is set (the teacher's save wins).
  writingAiScore Int?
  writingAiComment String? @db.VarChar(1000)
  /// the student's level before and after this article
  levelBefore  Int
  levelAfter   Int?
  /// only the first completed reading of an article counts (first-try score, level changes, goals)
  firstTry     Boolean   @default(true)
  /// a "stretch" reading: one level above the student's level (extra challenge, never lowers the level)
  stretch      Boolean   @default(false)
  /// highlights and notes made while reading: [{ start, end, color, note? }]
  annotations  Json?
  /// the student listened to the read-aloud
  listened     Boolean   @default(false)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  /// owner r69 (accuracy): when the 8 questions opened (step 3), the answer time of each question and the rapid
  /// guesses among them ({ ms: { "1": 5400, … }, rapid: [3, 4] }); 2+ rapid answers = an Unreliable run (teacher-only):
  /// it never moves the level, never counts toward goals and never feeds the skills
  quizAt       DateTime?
  answerMs     Json?
  rapidCount   Int       @default(0)
  unreliable   Boolean   @default(false)

  @@index([studentId, completedAt])
  @@index([schoolId, completedAt])
  @@index([articleId])
}

/// placement test: short passages at rising levels, 3 questions each, the level moves up or down after each passage
model RRPlacement {
  id          String    @id @default(cuid())
  studentId   String
  schoolId    String
  startLevel  Int
  /// [{ level, passageId, answers, correct }]
  steps       Json
  result      Int?
  /// owner r69: the reading check of the school year it belongs to — BOY | MOY | EOY (null = an older row)
  period      String?   @db.VarChar(3)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([studentId, startedAt])
}

/// a teacher can put an article on a class's list (students still read their own level)
model RRClassArticle {
  id           String    @id @default(cuid())
  classId      String
  articleId    String
  assignedById String
  dueAt        DateTime?
  startAt     DateTime? // owner r68 §D: the day students see it (null: at once); dueAt is the end
  createdAt    DateTime  @default(now())

  @@unique([classId, articleId])
}

// ------------------------------------------------------ question re-classification ----

/// 📊 A question's statistics per grade from students' FIRST answers (no retries, rapid guesses or hinted answers).
model QuestionGradeStat {
  id               String   @id @default(cuid())
  questionId       String
  grade            Int
  responses        Int
  correct          Int
  pct              Float
  /// answers and % right of students whose level is On (the basis for the level)
  responsesOnLevel Int      @default(0)
  pctOnLevel       Float?
  /// { "A": 0.12, … } share of each option among all answers
  optionShares     Json?
  /// point-biserial (strong vs weak students); negative = strong students get it wrong more
  discrimination   Float?
  medianMs         Int?
  updatedAt        DateTime @updatedAt

  @@unique([questionId, grade])
  @@index([grade, responses])
}

/// 🔁 Every change of a question's level (automatic or approved), with its reason.
model QuestionLevelChange {
  id             String   @id @default(cuid())
  questionId     String
  grade          Int
  /// BELOW | ON | ABOVE
  fromLevel      String   @db.VarChar(6)
  toLevel        String   @db.VarChar(6)
  fromDifficulty Int
  toDifficulty   Int
  pct            Float
  responses      Int
  /// ON_LEVEL_STUDENTS | ALL_STUDENTS (non-adaptive work only)
  basis          String   @db.VarChar(20)
  /// AUTO | APPROVED
  source         String   @db.VarChar(10)
  reason         String   @db.VarChar(400)
  approvedById   String?
  createdAt      DateTime @default(now())

  @@index([questionId, createdAt])
  @@index([createdAt])
}

/// ⚠️ A possible problem with a question, found in students' answers: KEY_SUSPECT (under 20% right) ·
/// DISTRACTOR_MAGNET (one wrong option chosen by over 50%) · NEGATIVE_DISCRIMINATION (strong students wrong more
/// than weak) · TOO_EASY (over 95% right) · SLOW (much slower than similar questions).
model QuestionAlert {
  id           String    @id @default(cuid())
  questionId   String
  grade        Int
  kind         String    @db.VarChar(24)
  detail       String    @db.VarChar(400)
  data         Json?
  /// OPEN | RESOLVED | DISMISSED
  status       String    @default("OPEN") @db.VarChar(10)
  /// kept out of adaptive practice until an admin reviews it
  heldBack     Boolean   @default(false)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([questionId, grade, kind])
  @@index([questionId, status])
  @@index([status, createdAt])
}

/// 🔗 Skill evidence from activities whose questions are not bank questions (Update 39B, closing the loop): ReadRise
/// article questions, word reviews, teacher-scored writing and Respond to Reading. Each row is one scored response
/// feeding the skill's mastery through the same engine (computeMastery) with a weight; (studentId, source, refId) is
/// unique, so the same response is never counted twice.
model SkillEvidence {
  id          String   @id @default(cuid())
  studentId   String
  skillId     String
  /// READRISE | VOCAB | WRITING | RTR
  source      String   @db.VarChar(12)
  /// the source row (e.g. "<runId>:3" = ReadRise run, question 3)
  refId       String   @db.VarChar(120)
  /// 0..1 credit (a rubric score is scaled to 0..1)
  credit      Float
  /// difficulty on the student's grade scale (0 = grade level) and the guessing floor
  difficultyB Float    @default(0)
  guessC      Float    @default(0)
  /// evidence weight 0..1 (lower for indirect evidence)
  weight      Float    @default(1)
  createdAt   DateTime @default(now())

  @@unique([studentId, source, refId])
  @@index([studentId, skillId, createdAt])
}

/// ⚖️ The student's overall level (Below / On / Above) as the daily job last confirmed it (Update 39B, hysteresis):
/// the level changes only when new evidence crosses the boundary by a margin, rests on enough new answers and holds on
/// two evaluations in a row (or 7+ days). Also keeps the recent ability (θ, 0 = grade level) and the decline check.
model StudentLevelState {
  studentId    String    @id
  schoolId     String
  level        MapLevel
  /// the evidence that set it: PLATFORM | PLACEMENT | LEXILE | MAP | TEACHER | SAVED | NO_DATA
  source       String    @db.VarChar(12)
  reason       String    @db.VarChar(500)
  since        DateTime
  /// a different level the evidence points to, not confirmed yet
  pending      MapLevel?
  pendingSince DateTime?
  pendingCount Int       @default(0)
  theta        Float?
  thetaSE      Float?
  effN         Float     @default(0)
  thetaRecent  Float?
  thetaPrior   Float?
  declining    Boolean   @default(false)
  evaluatedAt  DateTime
  updatedAt    DateTime  @updatedAt

  @@index([schoolId, level])
}

/// 🎯 UI reorg Phase 1: NAFS (national test) English areas — a list the admin edits (stored as data, like the MAP goal
/// areas). Skills join an area through their skill family (NafsSkillLink); every question counts under its skill's area
/// unless it has its own area (NafsQuestionArea).
model NafsArea {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(120)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Skill family (one master skill across grades) → NAFS area. source: AUTO (seeded from the skill's MAP area, standards,
/// domain and category) | ADMIN (set on /admin/nafs-links; never overwritten automatically).
model NafsSkillLink {
  familyId  String   @id
  areaId    String
  source    String   @db.VarChar(8)
  updatedAt DateTime @default(now())

  @@index([areaId])
}

/// A question's own NAFS area: an explicit override of its skill's area (set by an admin).
model NafsQuestionArea {
  questionId String   @id
  areaId     String
  setById    String?
  setAt      DateTime @default(now())

  @@index([areaId])
}

/// "Needs review": a link the platform could not make confidently (it never guesses silently). kind: QUESTION (bank
/// question → skill) | READRISE (ReadRise question kind → skill family) | FAMILY_MAP | FAMILY_NAFS (skill → area).
/// status OPEN | APPROVED (the best guess, or the admin's choice in guessId, was applied) | DISMISSED.
model SkillLinkReview {
  id           String    @id @default(cuid())
  schoolId     String
  kind         String    @db.VarChar(16)
  subjectId    String    @db.VarChar(64)
  excerpt      String    @db.VarChar(200)
  guessId      String?   @db.VarChar(40)
  guessLabel   String?   @db.VarChar(160)
  confidence   Float
  reason       String    @db.VarChar(255)
  status       String    @default("OPEN") @db.VarChar(10)
  createdAt    DateTime  @default(now())
  reviewedById String?
  reviewedAt   DateTime?

  @@unique([schoolId, kind, subjectId])
  @@index([schoolId, status])
}

// ------------------------------------------------------------------ UI reorg Phase 5: Assessments (teacher-built tests)

/// A test built in Assessments from skills: one or more Assignments (one per level group) carry its testId.
model TeacherTest {
  id            String    @id @default(cuid())
  schoolId      String
  classId       String
  /// Teacher.id of the class teacher who built it
  teacherId     String
  createdById   String
  title         String    @db.VarChar(191)
  /// NAFS | MAP | DIAGNOSTIC | WEEKLY_QUIZ | CHAPTER_TEST | CUSTOM (shown as "Other" in reports)
  testType      String    @db.VarChar(24)
  /// SAME (same questions for all) | LEVEL (at each student's level: Below / On / Above)
  levelMode     String    @default("SAME") @db.VarChar(8)
  skillIds      Json
  openAt        DateTime?
  dueAt         DateTime?
  timeLimitMin  Int?
  shuffle       Boolean   @default(false)
  templateId    String?
  reteachAt     DateTime?
  /// NAFS tests: when the personal NAFS plans were made from the results (button, or the daily job after the due date)
  nafsPlanAt    DateTime?
  /// points per question { questionId: points } (⚡ Make the test for me / the builder's marks); null = 1 point each
  marks         Json?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([classId, createdAt])
  @@index([schoolId, teacherId])
}

/// A saved test to reuse and edit later (private to the teacher who saved it).
model TestTemplate {
  id          String   @id @default(cuid())
  schoolId    String
  createdById String
  title       String   @db.VarChar(191)
  testType    String   @db.VarChar(24)
  /// { skills: [{ skillId, count }], levelMode, timeLimitMin, shuffle, questions: { SAME | BELOW | ON | ABOVE: string[] } }
  spec        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([schoolId, createdById])
}

/// Pre-generated read-aloud audio (UI reorg Phase 6), made by scripts/tts/pregenerate.ts. Looked up by the
/// SHA-256 of the spoken text (passage or question text only, never student data), so the same text is stored
/// once and changed text simply gets new audio. Stored in the database because the web server's disk is wiped on
/// every deploy. `timings`: JSON { v, exact, words: [start ms of each word] } for word highlighting.
model TtsAudio {
  id         String   @id @default(cuid())
  textHash   String   @unique @db.VarChar(64)
  provider   String   @db.VarChar(20)
  voice      String   @db.VarChar(120)
  mime       String   @db.VarChar(40)
  bytes      Bytes    @db.MediumBlob
  size       Int
  durationMs Int
  chars      Int
  timings    String   @db.MediumText
  /// where the text came from, e.g. passage:<id> (for the admin's information only)
  source     String?  @db.VarChar(80)
  createdAt  DateTime @default(now())
}

// ------------------------------------------------------------------ 🎖️ Motivation (Games Part 3): coins, avatar, favorite badge, Question of the Day, certificates
// Rewards are kept apart from learning data: nothing here is read by the adaptive engine, levels, mastery, scores or reports.

/// One row per student: coin balance (sum of CoinLedger), the avatar they wear, their favorite badge (emblem) and when
/// rewards were last brought up to date. Read once per page for the top bar (cached briefly).
model StudentReward {
  studentId     String    @id
  coins         Int       @default(0)
  /// lifetime coins earned (purchases not subtracted)
  earned        Int       @default(0)
  /// { base, color, hat, glasses, bg } — codes from src/lib/avatar.ts
  avatar        Json?
  favoriteBadge String?   @db.VarChar(40)
  syncedAt      DateTime?
  updatedAt     DateTime  @updatedAt
}

/// Every coin earned or spent. One row per (student, reason, refId): the same event can never pay twice.
/// reason: work | mastered | levelup | plan | qotd | game | live | live.win | bonus | shop
model CoinLedger {
  id          String   @id @default(cuid())
  studentId   String
  amount      Int
  reason      String   @db.VarChar(24)
  refId       String   @db.VarChar(120)
  note        String?  @db.VarChar(200)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([studentId, reason, refId])
  @@index([studentId, createdAt])
}

/// The Question of the Day answer (one per student per day, Saudi time). Never changes levels or mastery.
model QotdAnswer {
  id         String   @id @default(cuid())
  studentId  String
  /// YYYY-MM-DD (Saudi time)
  day        String   @db.VarChar(10)
  questionId String
  skillId    String?
  /// the level the question was asked at (ON / ABOVE / HARDEST)
  level      String   @db.VarChar(8)
  correct    Boolean
  createdAt  DateTime @default(now())

  @@unique([studentId, day])
  @@index([studentId, correct])
}

/// A certificate (printable PDF made on download): automatic on a level up or a finished plan, or made by a teacher.
model Certificate {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  /// LEVEL_UP | PLAN | MANUAL
  kind        String   @db.VarChar(12)
  title       String   @db.VarChar(191)
  detail      String?  @db.VarChar(300)
  refId       String   @db.VarChar(120)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([studentId, kind, refId])
  @@index([studentId, createdAt])
}

/// 💬 In-app feedback (the Feedback button): what a user wrote and on which page; admins mark it resolved.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String?
  /// the sender's role when they wrote it (ADMIN roles, TEACHER, STUDENT)
  role      String   @db.VarChar(20)
  path      String?  @db.VarChar(300)
  message   String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)

  @@index([schoolId, resolved, createdAt])
  @@index([userId, createdAt])
}

/// ⭐ Second Chance: the student re-answers a question they got wrong (practice, tests, ReadMaster, ReadRise, Question
/// of the Day). Practice only: never read by levels, mastery, tiers, reports or norms, and never written to the
/// attempt tables. questionId = a bank Question id, or "rr:<RRQuestion id>" for a ReadRise question.
model SecondChanceAnswer {
  id         String   @id @default(cuid())
  studentId  String
  questionId String   @db.VarChar(64)
  correct    Boolean
  createdAt  DateTime @default(now())
  /// null = an answer given in Second Chance · GAME = a question missed in a game (solo round or live game), which
  /// waits in Second Chance like any other mistake (games never write attempts)
  source     String?  @db.VarChar(12)

  @@index([studentId, questionId])
  @@index([studentId, createdAt])
}

/// 🗓️ When students of a grade may take the school year's Diagnostic Test — set ONLY by the school admin
/// (/admin/diagnostic). MANUAL: open while isOpen. AUTO: open from opensAt to closesAt, by itself.
model DiagnosticWindow {
  id          String    @id @default(cuid())
  schoolId    String
  grade       Int
  /// MANUAL | AUTO
  mode        String    @default("MANUAL") @db.VarChar(6)
  isOpen      Boolean   @default(false)
  opensAt     DateTime?
  closesAt    DateTime?
  /// school year, e.g. "2026-2027" (Aug 1 → Jul 31)
  schoolYear  String    @db.VarChar(9)
  updatedAt   DateTime  @default(now())
  updatedById String?

  @@unique([schoolId, grade, schoolYear])
}

// ------------------------------------------------------------------ 🇸🇦 NAFS section (teacher; src/server/nafs/*)

/// The NAFS reading skills — the ONLY skills of the NAFS section (seeded from src/server/nafs/framework.ts with
/// stable codes NAFS.RC.MAIN … NAFS.P4). domain: RC · IAE · V · PIRLS; process: the default PIRLS process (P1–P4)
/// of a question of this skill.
model NafsSkill {
  code      String  @id @db.VarChar(24)
  domain    String  @db.VarChar(8)
  name      String  @db.VarChar(120)
  process   String? @db.VarChar(4)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

/// NAFS skill → the platform's skill family (Main Idea, Synonyms and Antonyms …): AUTO from the family's name, or
/// ADMIN (set on the NAFS Skills tab). Shared by every school, like NafsSkillLink.
model NafsSkillFamily {
  nafsCode  String   @db.VarChar(24)
  familyId  String
  source    String   @db.VarChar(8)
  updatedAt DateTime @default(now())

  @@id([nafsCode, familyId])
  @@index([familyId])
}

/// One question in a school's NAFS bank: the school's own question (made in the section, an AI draft, or the school
/// copy of an edited platform question: copyOfId), its NAFS skill / PIRLS process tag, hidden (never deleted).
model NafsBankItem {
  id          String   @id @default(cuid())
  schoolId    String
  questionId  String
  nafsCode    String?  @db.VarChar(24)
  process     String?  @db.VarChar(4)
  own         Boolean  @default(false)
  copyOfId    String?
  hidden      Boolean  @default(false)
  /// an AI draft waiting for the teacher's review (not usable in tests until approved)
  draft       Boolean  @default(false)
  /// the Ministry of Education NAFS standard (MOE.S01 … MOE.S13) set by the teacher or a model booklet; null = the
  /// skill's sure mapping (or a clear stem) decides
  standard    String?  @db.VarChar(8)
  /// a NAFS model booklet question (platform content): the booklet's code (NB-001) and the question's number in it
  booklet     String?  @db.VarChar(16)
  bookletN    Int?
  /// the question's own NAFS difficulty (1 Easy · 2 Medium · 3 Hard) from a model booklet, a practice set or the
  /// teacher; null = from the question's difficulty level / statistics
  difficulty  Int?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([schoolId, questionId])
  @@index([schoolId, own])
}

/// A NAFS test (simulation, automatic or manual): the questions in booklet order and their marks.
model NafsTest {
  id           String    @id @default(cuid())
  schoolId     String
  createdById  String
  title        String    @db.VarChar(191)
  /// SIMULATION | AUTO | MANUAL
  mode         String    @db.VarChar(12)
  questionIds  Json
  /// { questionId: marks }; null = 1 mark each
  marks        Json?
  timeLimitMin Int?
  /// what it was built from (chosen skills, counts, the simulation numbers)
  settings     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([schoolId, createdAt])
}

/// A NAFS test given to a Grade 6 class to answer online (simulation mode); releasedAt = the teacher released the
/// results to the students.
model NafsTestClass {
  id          String    @id @default(cuid())
  testId      String
  classId     String
  openAt      DateTime?
  dueAt       DateTime?
  releasedAt  DateTime?
  /// this assignment's own time in minutes (null = the test's time)
  timeLimitMin Int?
  /// r69 live time: the class's end time (no student's timer runs past it; null = none) — changed live by the teacher
  endsAt      DateTime?
  /// r69 live time: extra minutes per student { "<studentId>": +5 | -5 … } (a student's own extension or cut)
  studentMinutes Json?
  /// only these students of the class (Student ids); null = the whole class
  studentIds  Json?
  createdById String
  createdAt   DateTime  @default(now())

  @@unique([testId, classId])
  @@index([classId])
}

/// One student's answers to a NAFS test — online, from a bubble sheet or typed by the teacher. Answers only
/// (0–3 = A–D, null = blank, in the test's order): sheet images are never sent or stored.
model NafsResult {
  id          String    @id @default(cuid())
  testId      String
  classId     String
  studentId   String
  /// ONLINE | SHEET | TYPED
  source      String    @db.VarChar(8)
  answers     Json
  correct     Int       @default(0)
  points      Float     @default(0)
  maxPoints   Float     @default(0)
  /// short written answers typed online: { "<index>": "text" } (on paper there is no text)
  texts       Json?
  /// the teacher's rubric scores of the written answers: { "<index>": 0 | 1 | 2 } — never scored automatically
  writtenScores Json?
  startedAt   DateTime?
  submittedAt DateTime?
  gradedById  String?
  updatedAt   DateTime  @default(now())

  @@unique([testId, studentId])
  @@index([classId, testId])
  @@index([studentId])
}

/// 🇸🇦 NAFS adaptive practice (NAFS center, Tool 1): the teacher's chosen NAFS skills / Ministry standards (or chosen
/// questions) for a Grade 6 class or chosen students of it. Everything the students do is stored in the NAFS tables
/// below only — never in the platform's attempts, mastery or levels.
model NafsPractice {
  id           String    @id @default(cuid())
  schoolId     String
  createdById  String
  title        String    @db.VarChar(191)
  /// the targets practised: NAFS skill codes (NAFS.RC.MAIN …) and / or Ministry standards (MOE.S01 …)
  targets      Json
  /// the teacher's chosen questions (null = any question of the targets in the NAFS center)
  questionIds  Json?
  classId      String
  /// only these students of the class (Student ids); null = the whole class
  studentIds   Json?
  /// questions per student (null = the default); time in minutes (null = no limit)
  maxQuestions Int?
  timeLimitMin Int?
  dueAt        DateTime?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([schoolId, createdAt])
  @@index([classId])
}

/// One student's adaptive NAFS practice: the adaptive state per target (current difficulty, the last answers,
/// mastered), the question shown now, totals and time spent.
model NafsPracticeRun {
  id         String    @id @default(cuid())
  practiceId String
  studentId  String
  classId    String
  state      Json
  asked      Int       @default(0)
  correct    Int       @default(0)
  seconds    Int       @default(0)
  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([practiceId, studentId])
  @@index([studentId])
}

/// One answer in an adaptive NAFS practice (NAFS tables only): the question, its target, its difficulty (1–3),
/// the choice (0–3), right or wrong and the time taken.
model NafsPracticeAnswer {
  id         String   @id @default(cuid())
  runId      String
  practiceId String
  studentId  String
  questionId String
  target     String   @db.VarChar(24)
  difficulty Int
  choice     Int?
  correct    Boolean
  ms         Int      @default(0)
  at         DateTime @default(now())

  @@index([runId])
  @@index([practiceId])
  @@index([studentId, at])
}

// ------------------------------------------------------------------ 📘 Learn (short lessons + curriculum words)
// The lesson / word CONTENT lives in files (data/learn/lessons/LN-*.json, data/learn/words/G*.json), read once and
// kept in memory; these tables hold only what a school does with it (additive, read through safeIfBehind).

/// One Learn lesson file registered for a school (loaded by Admin → Load new questions, pack "Learn lessons", or in the
/// background): its metadata for lists, and whether the admin hid it (never deleted).
model LearnLesson {
  id           String    @id @default(cuid())
  schoolId     String
  code         String    @db.VarChar(20)
  title        String    @db.VarChar(191)
  /// READING | LANGUAGE
  subject      String    @db.VarChar(10)
  goalArea     String    @db.VarChar(60)
  subtopic     String?   @db.VarChar(191)
  standards    Json
  families     Json
  skillNames   Json
  /// sha1 of the file's text when loaded (a changed file updates the row)
  fileHash     String    @db.VarChar(40)
  hidden       Boolean   @default(false)
  hiddenReason String?   @db.VarChar(300)
  hiddenById   String?
  hiddenAt     DateTime?
  loadedAt     DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@unique([schoolId, code])
  @@index([schoolId, hidden])
}

/// A teacher's (or the admin's) edit of one lesson level or one curriculum word. The file is never changed:
/// PENDING = the teacher's own version (their classes see it) sent to the admin; APPROVED = the school's version;
/// REJECTED = stays the teacher's own; WITHDRAWN = restored to the original; RETIRED = an older school version.
model LearnEdit {
  id              String    @id @default(cuid())
  schoolId        String
  /// LESSON | WORD
  kind            String    @db.VarChar(8)
  /// lesson code (LN-001) or word key "<grade>|<unit>|<number>|<word>"
  ref             String    @db.VarChar(160)
  /// the lesson level (1–4); 0 for a word
  level           Int       @default(0)
  authorUserId    String
  /// the author's Teacher id (null for an admin)
  authorTeacherId String?
  content         Json
  /// what the author started from (for the admin's word-level diff)
  base            Json?
  status          String    @db.VarChar(10)
  note            String?   @db.VarChar(300)
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  @@index([schoolId, kind, ref])
  @@index([schoolId, status])
}

/// "Report a problem" on a lesson or a word (to the admin's list).
model LearnReport {
  id         String    @id @default(cuid())
  schoolId   String
  kind       String    @db.VarChar(8)
  ref        String    @db.VarChar(160)
  level      Int       @default(0)
  userId     String
  text       String    @db.VarChar(1000)
  /// OPEN | DONE
  status     String    @default("OPEN") @db.VarChar(6)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([schoolId, status])
}

/// A lesson (kind LESSON, ref = code) or a selection's words (kind WORDS, ref = "<grade>|<unit>|<number>") a teacher
/// gave to a class, a level group of a class or some students, with an optional level and due date.
model LearnAssign {
  id          String    @id @default(cuid())
  schoolId    String
  kind        String    @db.VarChar(6)
  ref         String    @db.VarChar(160)
  title       String    @db.VarChar(191)
  classId     String?
  /// CLASS | GROUP | STUDENTS
  target      String    @db.VarChar(8)
  /// GROUP: the level group (BELOW | ON | ABOVE) — teacher side only
  groupLevel  String?   @db.VarChar(6)
  /// 1–4: the teacher's choice of level (null = automatic)
  level       Int?
  dueAt       DateTime?
  startAt     DateTime? // owner r68 §D: the day students see it (null: at once); dueAt is the end
  createdById String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([schoolId, createdAt])
  @@index([schoolId, kind, ref])
}

/// One student of a LearnAssign (ONE read for My Work): the title, level and due date are kept here too.
model LearnAssignee {
  id        String    @id @default(cuid())
  assignId  String
  schoolId  String
  studentId String
  kind      String    @db.VarChar(6)
  ref       String    @db.VarChar(160)
  title     String    @db.VarChar(191)
  level     Int?
  dueAt     DateTime?
  startAt     DateTime? // owner r68 §D: the day students see it (null: at once); dueAt is the end
  /// NOT_STARTED | IN_PROGRESS | DONE
  status    String    @default("NOT_STARTED") @db.VarChar(12)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())

  @@unique([assignId, studentId])
  @@index([studentId])
  @@index([schoolId, kind, ref])
}

/// A student's work on one lesson (kind LESSON) or one selection's words (kind WORDS): opened, finished, the checks
/// score (of 3; words: of 5), whether the "again" explanation was needed, attempts and time in seconds.
model LearnProgress {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  kind        String    @db.VarChar(6)
  ref         String    @db.VarChar(160)
  level       Int       @default(2)
  openedAt    DateTime  @default(now())
  finishedAt  DateTime?
  score       Int?
  best        Int?
  neededAgain Boolean   @default(false)
  attempts    Int       @default(0)
  seconds     Int       @default(0)
  updatedAt   DateTime  @default(now())

  @@unique([studentId, kind, ref])
  @@index([schoolId, kind, ref])
}

/// 📘 A Learn lesson the platform sent BY ITSELF (src/server/learn/auto.ts) because of a clear, strong problem on one
/// skill: the reason and its evidence numbers, the LearnAssign it made, and the teacher's decision.
/// status: SENT (new) | KEPT | UNDONE (removed before the student started: never sent again) | CHANGED (another lesson
/// was given instead). Switches live in SchoolSetting ("learn.auto", "learn.auto.class:<classId>").
model LearnAuto {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  classId     String?
  skillId     String
  skillName   String    @db.VarChar(191)
  ref         String    @db.VarChar(20)
  title       String    @db.VarChar(191)
  /// ACCURACY | DROPS | URGENT
  trigger     String    @db.VarChar(8)
  /// the reason in plain words (English; pages rebuild it from trigger + evidence in the reader's language)
  reason      String    @db.VarChar(300)
  evidence    Json
  assignId    String
  status      String    @default("SENT") @db.VarChar(8)
  /// the scan that sent it (one bell notice per scan)
  scanAt      DateTime
  decidedById String?
  decidedAt   DateTime?
  note        String?   @db.VarChar(300)
  createdAt   DateTime  @default(now())

  @@index([schoolId, createdAt])
  @@index([studentId, createdAt])
}

/// 👪 The teacher's note on a student's weekly family report ("For my family" this week —
/// src/server/reports/family-week.ts): one per student per school week (week = its Sunday, "YYYY-MM-DD").
model FamilyWeekNote {
  id        String   @id @default(cuid())
  studentId String
  week      String   @db.VarChar(10)
  note      String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, week])
  @@index([week])
}

/// 🚫 "Assigned" (src/server/teacher/assigned.ts): a SOFT cancel of something a teacher assigned — for everyone
/// (studentId null) or for one student. Nothing is deleted: the students' answers and results stay; My Work, the home
/// badge and the menu numbers hide the work while restoredAt is null. Undo = restoredAt set (the row is kept).
model AssignmentCancel {
  id            String    @id @default(cuid())
  schoolId      String
  /// SKILL | PROGRESS_CHECK | TEST | MAP_TEST | NAFS_TEST | NAFS_PRACTICE | LEARN | WORDS | READRISE | WRITING | FLUENCY | EXIT_TICKET | RESPOND | PLAN | LESSON
  kind          String    @db.VarChar(16)
  /// the assigned row's id (Assignment, TeacherTest, MapSimWindow, NafsTestClass, NafsPractice, LearnAssign, RRClassArticle, WritingTask, ExitTicket, RespondAssignment, SkillPlan, LessonRun)
  refId         String    @db.VarChar(191)
  classId       String?
  /// null = cancelled for everyone; else removed for this one student
  studentId     String?
  /// the My Work row keys this hides (worked out when cancelled)
  keys          Json
  title         String    @db.VarChar(191)
  cancelledById String
  cancelledAt   DateTime  @default(now())
  restoredAt    DateTime?
  restoredById  String?

  @@index([schoolId, restoredAt])
  @@index([kind, refId])
}

/// 🔁 A teacher's own Review set for one Curriculum Map Review place (owner r67, src/server/curriculum-map/
/// review-control.ts): the chosen questions in order (the place's shared questions, the teacher's private edited
/// copies and the teacher's own written questions), the shared ones the teacher removed, and HOW MANY questions the
/// students answer. The shared originals are never changed or deleted.
model TeacherReviewSet {
  id            String   @id @default(cuid())
  schoolId      String
  teacherUserId String
  /// the Review place, e.g. G4.U1.TS1.REV
  code          String   @db.VarChar(120)
  questionIds   Json
  hiddenIds     Json?
  count         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@unique([teacherUserId, code])
  @@index([schoolId])
}

/// 🗓️ A class's MAP Year plan (owner r67, src/server/map/year-plan.ts): 40 school weeks of 2–3 skills the class's
/// students share as needs (MAP results + continuum + the curriculum). weeks = [{ week, skills: [...] }]; needs = the
/// class's need list when it was made (for Replace / Add). Stars (assigned) are read from Assignment, not kept here.
model MapYearPlan {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String   @unique
  startDate   DateTime
  weeks       Json
  needs       Json?
  createdById String
  generatedAt DateTime @default(now())
  updatedAt   DateTime @default(now())
  /// owner r68 §C: sent to the class's students (their MAP page shows a Year plan tab); null = teachers only
  sentAt      DateTime?
  sentById    String?

  @@index([schoolId])
}

/// ⭐ ONE status per student per skill per level (owner r67 "skill stars", src/server/skills/status.ts). skillKey names
/// the SAME skill everywhere (taxonomy family code, e.g. "fam:character"; see skillKeyIndex). status: NOT_STARTED ·
/// IN_PROGRESS · MASTERED · NEXT_LEVEL · NEEDS_REVIEW. level = the student's challenge level when this row was made
/// (1 = first; a new MAP result moving the student up opens level 2 for the harder skills). history = [{ at, status, why }].
model SkillStatus {
  id             String    @id @default(cuid())
  studentId      String
  skillKey       String    @db.VarChar(80)
  level          Int       @default(1)
  status         String    @db.VarChar(14)
  /// the skill row practised last (for links and coins)
  skillId        String?
  /// answered skill-practice questions counted for the 30–50 rule (rapid guesses, tests, reviews, Learn checks excluded)
  answered       Int       @default(0)
  correct        Int       @default(0)
  /// the engine's mastery % (shown capped at 99 until 30 answered)
  score          Float     @default(0)
  startedAt      DateTime?
  masteredAt     DateTime?
  reviewDueAt    DateTime?
  /// 50 answers without mastery: the teacher sees "Needs support" (the student still sees In progress)
  needsSupportAt DateTime?
  /// last time the mastery % rose (stuck at In progress 7+ days → Needs attention / a Learn suggestion)
  progressAt     DateTime?
  /// the answered count when the mastery % last rose (25+ answers without progress → a Learn suggestion)
  progressAnswered Int     @default(0)
  /// the student's self-check after the skill: HAPPY | OK | UNSURE
  selfCheck      String?   @db.VarChar(8)
  /// the student saw the "new star" celebration (null = not yet)
  celebratedAt   DateTime?
  /// a skipped Learn suggestion (not shown again until this date)
  learnSkippedAt DateTime?
  history        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  @@unique([studentId, skillKey, level])
  @@index([skillKey, status])
  @@index([status, updatedAt])
}

/// 🔄 A review check (5 questions, 3 weeks after ⭐) or the monthly mixed review (10 questions from several ⭐ skills),
/// given in My Work as a question set (assignmentId). Never counted in the 30 rule. result = { right, answered, guesses,
/// outcome: PASS | FAIL | GUESSING, perKey }.
model SkillReviewCheck {
  id           String    @id @default(cuid())
  studentId    String
  /// REVIEW | MIXED
  kind         String    @db.VarChar(8)
  skillKeys    Json
  assignmentId String?
  /// MIXED: the month (yyyy-mm); REVIEW: the skill key + the due date — one check per due review
  periodKey    String    @db.VarChar(120)
  createdAt    DateTime  @default(now())
  settledAt    DateTime?
  result       Json?

  @@unique([studentId, kind, periodKey])
  @@index([assignmentId])
  @@index([studentId, settledAt])
}

/// A one-time notice a user dismissed (e.g. the "New: skill stars" card on the teacher home).
model UserNotice {
  userId    String
  key       String   @db.VarChar(40)
  seenAt    DateTime @default(now())

  @@id([userId, key])
}
