  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  criteria    Json

  awards StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   String
  awardedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
  badge   Badge   @relation(fields: [badgeId], references: [id])

  @@id([studentId, badgeId])
}

/// XP is only awarded by the server for meaningful events (mastery gain, non-rapid correct answers).
model XpEvent {
  id        BigInt   @id @default(autoincrement())
  studentId String
  points    Int
  reason    String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  action     String // "question.publish", "student.move", "settings.update"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

