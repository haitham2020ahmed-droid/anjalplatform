// ------------------------------------------------- analytics summary tables ----
// Filled by the nightly rollup job (src/analytics/rollups.ts). Dashboards read these
// instead of scanning QuestionAttempt, so page loads stay flat as data grows.

model StudentDailyActivity {
  studentId       String
  day             DateTime @db.Date
  questions       Int      @default(0)
  correct         Int      @default(0)
  activeMs        Int      @default(0)
  skillsPracticed Int      @default(0)
  maxLevel        Int      @default(0)

  student Student @relation(fields: [studentId], references: [id])

  @@id([studentId, day])
  @@index([day])
}

model ClassSkillDaily {
  classId           String
  skillId           String
  day               DateTime @db.Date
  studentsPracticed Int      @default(0)
  attempts          Int      @default(0)
  correct           Int      @default(0)
  avgMastery        Float?
  masteredStudents  Int      @default(0)

  class Class @relation(fields: [classId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

