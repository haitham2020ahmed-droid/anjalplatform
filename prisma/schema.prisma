/// Fixed-window rate-limit counters (login attempts per username+IP, per IP). DB-backed so limits
/// hold across several app servers; old rows are purged by the nightly job.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

/// Result of a placement / diagnostic check (INTERNAL estimate — never an official MAP score).
model DiagnosticResult {
  id                   String   @id @default(cuid())
  studentId            String
  sessionId            String   @unique
  takenAt              DateTime @default(now())
  questions            Int
  overallTheta         Float
  overallSE            Float
  proficiency          String // "Below grade level" | "Approaching grade level" | "At grade level" | "Above grade level"
  domains              Json // [{domain, theta, se, items, correct, label}]
  strongDomains        Json
  weakDomains          Json
  recommendedSkillIds  Json // where to start
  interventionSkillIds Json // suggested support
  engineVersion        String

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, takenAt])
}

/// Question-bank import: what happened to each question detected in an uploaded file.
enum ImportedQuestionStatus {
  VALID      // ready to import
  INVALID    // has errors; fix in the preview or leave unselected
  DUPLICATE  // looks like an existing question; decision decides what happens
  IMPORTED
  REPLACED   // imported and the old question was archived
  SKIPPED
  FAILED
}

enum ImportDecision {
  IMPORT   // add as a new question
  SKIP     // do not import
  REPLACE  // archive the matching question, then import this one
  FORCE    // import even though it looks like a duplicate
}

model ImportedQuestionLog {
  id            String                 @id @default(cuid())
  jobId         String
  rowIndex      Int
  status        ImportedQuestionStatus
  decision      ImportDecision         @default(IMPORT)
  selected      Boolean                @default(true)
  /// original text of this question in the file (for the preview)
  source        String                 @db.Text
  /// detected question in editor form (type, stem, options, answers, skill, standard, level…)
  detected      Json
  errors        Json?
  warnings      Json?
  duplicateOfId String?
  similarity    Float?
  /// the question created by the import (or replaced)
  questionId    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowIndex])
  @@index([jobId, status])
}

/// Optional image for a question (diagram, chart, map, picture). Stored in the database because the
/// web server's disk is not persistent on the hosting plan; images are resized and capped at 1 MB.
model QuestionImage {
  id        String   @id @default(cuid())
  mime      String   @db.VarChar(40)
  bytes     Bytes    @db.MediumBlob
  size      Int
  width     Int?
  height    Int?
  sha256    String   @db.VarChar(64)
  altText   String?  @db.VarChar(300)
  createdById String?
  createdAt DateTime @default(now())

  @@index([sha256])
}


// ------------------------------------------------------------------ Curriculum Map (Grade → Book → Unit → Text Set/Selection → Category → Level)

enum MapNodeKind {
  BOOK
  UNIT
  TEXT_SET
  SELECTION
  CATEGORY
  LEVEL
}

enum MapCategoryType {
  CONCEPT_VOCABULARY
  ANALYZE_CRAFT_AND_STRUCTURE
  RESPOND_TO_READING
  REVIEW
}

enum MapLevel {
  ABOVE
  ON
  BELOW
}

/// One node of the school's Curriculum Map (a tree per grade). Names are stored exactly as the school
/// wrote them. Questions will later be linked ONLY to nodes with acceptsQuestions = true:
/// Concept Vocabulary, and the Above/On/Below levels of Analyze Craft and Structure and Respond to Reading.
/// Independent of the adaptive curriculum (Unit/Lesson/Skill), which it does not change.
model CurriculumMapNode {
  id               String           @id @default(cuid())
  gradeId          String
  parentId         String?
  kind             MapNodeKind
  /// stable unique key per grade, e.g. G4.U1.TS1.ACS.ABOVE (for Question Bank / import mapping)
  code             String           @db.VarChar(120)
  number           Int?
  /// exact text: “Unit 1”, “Text Set 1: Expository Text” → title “Expository Text”, “1- Concept Vocabulary”, “Above Level”
  title            String           @db.VarChar(255)
  /// text sets/selections: the full heading as written, e.g. “Text Set 1: Expository Text”
  heading          String?          @db.VarChar(255)
  /// text sets (Grades 4–5) only, exactly as written incl. curly quotes; empty for Grade 6
  sharedRead       String?          @db.VarChar(255)
  genre            String?          @db.VarChar(120)
  categoryType     MapCategoryType?
  /// the skill(s) in parentheses, exactly as written (one string), e.g. “Reread / Diagrams and Headings \ Compare and Contrast”
  skills           String?          @db.VarChar(500)
  level            MapLevel?
  /// true only for the nodes questions will be linked to
  acceptsQuestions Boolean          @default(false)
  bookId           String?
  sortOrder        Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  grade            Grade            @relation(fields: [gradeId], references: [id])
  book             Book?            @relation(fields: [bookId], references: [id])
  parent           CurriculumMapNode?  @relation("MapTree", fields: [parentId], references: [id])
  children         CurriculumMapNode[] @relation("MapTree")

  @@unique([gradeId, code])
  @@index([gradeId, parentId, sortOrder])
  @@index([acceptsQuestions])
  questionLinks    QuestionMapLink[]
}


/// A question placed on the Curriculum Map (only on nodes with acceptsQuestions = true).
/// Every question is in the Question Bank; a link adds it to the curriculum too (one way: bank-only
/// questions are not on the map until linked).
model QuestionMapLink {
  questionId  String
  nodeId      String
  createdById String?
  createdAt   DateTime          @default(now())
  question    Question          @relation(fields: [questionId], references: [id])
  node        CurriculumMapNode @relation(fields: [nodeId], references: [id])

  @@id([questionId, nodeId])
  @@index([nodeId])
}

enum QuestionUseKind {
  PLACEMENT
  MAP_TEST
}

/// What a Question Bank question may be used for besides practice: Placement and/or MAP tests (both allowed).
model QuestionUse {
  questionId String
  use        QuestionUseKind
  createdAt  DateTime        @default(now())
  question   Question        @relation(fields: [questionId], references: [id])

  @@id([questionId, use])
  @@index([use])
}


/// Files a school uploads that must survive redeploys (the server disk is wiped on every deploy): the logo.
model SchoolAsset {
  id        String   @id @default(cuid())
  schoolId  String
  kind      String   @db.VarChar(30)
  mime      String   @db.VarChar(60)
  bytes     Bytes    @db.MediumBlob
  sha256    String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([schoolId, kind])
}


/// Each student's reading level for the Curriculum Map (Above / On / Below Level): set by the teacher or by
/// the Placement test. Assigning from the map gives every student the questions of their own level.
model StudentLevel {
  studentId String   @id
  level     MapLevel
  /// TEACHER or PLACEMENT
  source    String   @db.VarChar(20)
  setById   String?
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------ ⭐ ReadMaster (leveled articles, Achieve3000-style)

/// One article (topic + skill) written in up to three versions: Below / On / Above Level (different Lexile).
model ReadMasterArticle {
  id          String   @id @default(cuid())
  schoolId    String
  /// short unique code per school (used by the import to group rows), e.g. SOLAR-01
  code        String   @db.VarChar(60)
  title       String   @db.VarChar(255)
  topic       String?  @db.VarChar(191)
  gradeLevel  Int
  skillId     String?
  skillName   String?  @db.VarChar(191)
  /// the Common Core standard the article practises, e.g. CCSS.ELA-LITERACY.RI.6.2 (its questions get it too)
  standardCode String? @db.VarChar(80)
  /// DRAFT or PUBLISHED (students see published articles of their grade)
  status      String   @default("DRAFT") @db.VarChar(20)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId, gradeLevel])
}

/// The same article at one reading level: different words and length, its own Lexile.
model ReadMasterVersion {
  id        String   @id @default(cuid())
  articleId String
  level     MapLevel
  lexile    Int
  body      String   @db.Text
  wordCount Int
  createdAt DateTime @default(now())

  @@unique([articleId, level])
}

/// Questions of a version (regular Question rows: they are also in the Question Bank).
model ReadMasterQuestion {
  versionId  String
  questionId String
  order      Int

  @@id([versionId, questionId])
  @@index([questionId])
}

/// Each student's ReadMaster reading Lexile: starts from MAP, moves after every article.
model StudentReadingLexile {
  studentId String   @id
  lexile    Int
  /// MAP, START or READMASTER
  source    String   @db.VarChar(20)
  updatedAt DateTime @updatedAt
}

model ReadMasterAttempt {
  id           String   @id @default(cuid())
  studentId    String
  articleId    String
  versionId    String
  level        MapLevel
  lexileBefore Int
  lexileAfter  Int
  correct      Int
  total        Int
  /// Update 39C: seconds from opening the article to submitting it (reading + answering), recorded by the page;
  /// null for attempts saved before it was recorded
  seconds      Int?
  /// Update 39C: answers given faster than the rapid-guess line (per-question times from the page); null = not timed
  rapid        Int?
  /// ReadMaster page update: true = read at a level BELOW the student's own level for this article ("Practice"):
  /// saved and shown, but it does not move the reading Lexile or skill mastery. false = counted (own level or higher).
  practice     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([studentId])
  @@index([articleId])
}


/// 🗂️ A skill plan: a set of Curriculum Map places assigned together to a class (or chosen students).
/// Students open it as a map and tap a place to start its questions. Students come from its assignments.
model SkillPlan {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  title       String   @db.VarChar(191)
  /// PLACES (chosen places, assigned at once) | CURRICULUM (the whole grade; each place opens when a student starts it)
  kind        String   @default("PLACES") @db.VarChar(12)
  /// correct answers to finish each place (default 20)
  targetCorrect Int?
  /// CURRICULUM plans: the units students can open (null = all)
  openUnits   Json?
  /// CURRICULUM plans: unit calendar { "Unit 2: …": "2026-11-01" } — a unit opens by itself on its date
  unitDates   Json?
  gradeLevel  Int
  note        String?  @db.VarChar(1000)
  createdById String?
  createdAt   DateTime @default(now())
  /// 🗂️ Plan editor: DRAFT (nothing reaches students) | SENT | PAUSED (hidden from students for now) | WITHDRAWN.
  /// Rows from before the editor are SENT.
  status      String    @default("SENT") @db.VarChar(10)
  /// MAP | RTI | CURRICULUM | NAFS; null = custom (or an older row: read from kind)
  program     String?   @db.VarChar(16)
  /// the plan as the teacher edits it: { v, sections: [{ key, skillId, skillName, questionIds, auto, studentIds, lesson, assignmentId… }] }
  doc         Json?
  /// the platform's version (the suggestion before the teacher's edits), to show what changed
  baseline    Json?
  /// why the platform suggested it: { reason, sources, rows: [{ name, lines }] }
  source      Json?
  /// who the plan is for (null = the whole class)
  studentIds  Json?
  goals       String?   @db.VarChar(1000)
  startAt     DateTime?
  dueAt       DateTime?
  sentAt      DateTime?
  updatedAt   DateTime?

  @@index([schoolId, classId])
  @@index([classId, kind]) // a class's plans of one kind (Update 46)
  @@index([schoolId, status])
}

model SkillPlanItem {
  id            String @id @default(cuid())
  planId        String
  /// the Curriculum Map place or category code, e.g. G4.U1.TS2.ACS
  code          String @db.VarChar(80)
  label         String @db.VarChar(255)
  /// the assignments created for this place (one, or one per level)
  assignmentIds Json
  order         Int

  @@index([planId])
}


// ------------------------------------------------------------------ 🎮 Live games (Kahoot / Blooket style)

/// A live quiz game a teacher hosts; students join with a code or QR. LOBBY → QUESTION → REVEAL → … → FINISHED.
model LiveGame {
  id                 String    @id @default(cuid())
  schoolId           String
  classId            String?
  hostId             String
  /// the 6-digit join code (unique among games that are not finished)
  code               String    @db.VarChar(8)
  title              String    @db.VarChar(191)
  questionIds        Json
  status             String    @default("LOBBY") @db.VarChar(12)
  currentIndex       Int       @default(-1)
  questionStartedAt  DateTime?
  secondsPerQuestion Int       @default(20)
  createdAt          DateTime  @default(now())
  finishedAt         DateTime?
  /// Games Part 1: the game mode of a Live Challenge (registry id, e.g. "quiz-race"); null = an older live game
  mode               String?   @db.VarChar(32)
  /// Games Part 1: the saved summary of a Live Challenge (top players, class and student scores by skill, levels)
  summary            Json?

  @@index([code, status])
  @@index([schoolId, createdAt])
  @@index([classId, createdAt]) // ⚡ r67: a class's recent games (teacher week, games report) without a table scan
}

model LiveGamePlayer {
  id        String   @id @default(cuid())
  gameId    String
  studentId String
  nickname  String   @db.VarChar(60)
  score     Int      @default(0)
  streak    Int      @default(0)
  joinedAt  DateTime @default(now())

  @@unique([gameId, studentId])
}

model LiveGameAnswer {
  id            String   @id @default(cuid())
  gameId        String
  playerId      String
  questionIndex Int
  choice        String   @db.VarChar(191)
  correct       Boolean
  points        Int
  ms            Int
  createdAt     DateTime @default(now())

  @@unique([playerId, questionIndex])
  @@index([gameId, questionIndex])
}

/// 🎲 Games Part 1: ONE short row per game played (solo or Live Challenge) per student per skill. Only correct /
/// incorrect answers count for reports and Reteach; `points` are game points (luck and power-ups) and never change
/// levels, mastery or scores.
model GamePlay {
  id         String   @id @default(cuid())
  schoolId   String
  studentId  String
  skillId    String
  /// registry id of the game (src/games/registry.ts), e.g. "quiz-race"
  gameId     String   @db.VarChar(32)
  /// SOLO (Play menu) or LIVE (Live Challenge)
  mode       String   @default("SOLO") @db.VarChar(8)
  correct    Int      @default(0)
  incorrect  Int      @default(0)
  points     Int      @default(0)
  /// the Live Challenge (LiveGame.id) for LIVE rows
  liveGameId String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([studentId, createdAt])
}

/// 🎲 Games Part 1: a student's 1–5 star rating of a game (one per student and game; the latest counts).
model GameRating {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  gameId    String   @db.VarChar(32)
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([studentId, gameId])
  @@index([schoolId, gameId])
}

/// 🎲 Games Part 1: a teacher's saved Live Challenge setup (skills, game mode, questions, time, level mode).
model LiveChallengeTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  title     String   @db.VarChar(150)
  spec      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([userId])
}

/// 🌉 Cross-Grade Bridge: a Text Set's category linked to the same skill one grade up (🚀 challenge path for
/// Above Level students) and one grade down (🛟 support path for Below Level students). Rows here are the
/// school's own (imported or edited); places without a row use the automatic match.
model CrossGradeBridge {
  id            String   @id @default(cuid())
  schoolId      String
  /// a category of the Curriculum Map, e.g. G5.U1.TS2.ACS
  fromCode      String   @db.VarChar(80)
  challengeCode String?  @db.VarChar(80)
  supportCode   String?  @db.VarChar(80)
  /// IMPORT or MANUAL
  source        String   @default("IMPORT") @db.VarChar(12)
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, fromCode])
}


/// A student's working level in one Curriculum Map category (CV = Concept Vocabulary, ACS = Analyze Craft and
/// Structure, RTR = Respond to Reading), learned from their adaptive sets. The next set of that category starts here.
model StudentCategoryLevel {
  studentId String
  category  String   @db.VarChar(8)
  level     MapLevel
  source    String   @db.VarChar(20)
  updatedAt DateTime @updatedAt

  @@id([studentId, category])
}

/// ✍️ A Respond to Reading activity for one level of a Text Set (code G4.U1.TS1.RTR.BELOW / .ON / .ABOVE):
/// the writing prompt with the level's support (steps, word bank, sentence starters, checklist, hidden hint).
model RespondActivity {
  id               String   @id @default(cuid())
  schoolId         String
  code             String   @db.VarChar(120)
  title            String   @db.VarChar(255)
  prompt           String   @db.Text
  instructions     Json
  wordBank         Json
  sentenceStarters Json
  checklist        Json
  hint             String?  @db.Text
  /// the teacher's model answer (never shown to students)
  modelAnswer      String?  @db.Text
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([schoolId, code])
}

/// ✍️ Respond to Reading given to a class: each student gets ONE level's activity of the Text Set (set by the
/// teacher, automatically from the student's data or by hand). Students write the answer in their book and tap
/// “I finished my answer in my book”; the teacher tracks it and may give a score (0–4) and a short comment.
model RespondAssignment {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String
  /// the Text Set's Respond to Reading code, e.g. G4.U1.TS1.RTR
  setCode     String    @db.VarChar(120)
  title       String    @db.VarChar(255)
  dueAt       DateTime?
  startAt     DateTime? // owner r68 §D: the day students see it (null: at once); dueAt is the end
  note        String?   @db.VarChar(1000)
  createdById String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([classId, createdAt])
  @@index([schoolId, setCode])
}

model RespondAssignmentStudent {
  assignmentId String
  studentId    String
  level        MapLevel
  finishedAt   DateTime?
  /// teacher's score 0–4 (optional)
  score        Int?
  feedback     String?   @db.VarChar(1000)
  updatedAt    DateTime  @updatedAt

  @@id([assignmentId, studentId])
  @@index([studentId])
}

// ------------------------------------------------------------------ 🤖 AI tools (admin)

/// One run of an AI tool (Quality Check, Auto-Tag, Reading Level) over a set of questions / passages. Processed in
/// small batches that respect the provider's rate limits; it resumes where it stopped (items keep their status).
model AiJob {
  id          String    @id @default(cuid())
  schoolId    String
  /// QUALITY | TAG | READING
  tool        String    @db.VarChar(20)
  /// what it covers, e.g. {"grade":4,"skillId":"…"} or {"new":true}
  scope       Json
  /// QUEUED | RUNNING | DONE | STOPPED
  status      String    @default("QUEUED") @db.VarChar(12)
  total       Int       @default(0)
  done        Int       @default(0)
  failed      Int       @default(0)
  note        String?   @db.VarChar(500)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@index([schoolId, createdAt])
}

model AiJobItem {
  id        String   @id @default(cuid())
  jobId     String
  /// a question id (QUALITY, TAG) or a passage id (READING)
  targetId  String   @db.VarChar(60)
  /// PENDING | DONE | FAILED
  status    String   @default("PENDING") @db.VarChar(10)
  attempts  Int      @default(0)
  error     String?  @db.VarChar(500)
  updatedAt DateTime @updatedAt

  @@index([jobId, status])
}

/// What an AI tool (or a code check) suggests about one question / passage. Nothing changes until an admin approves.
model AiSuggestion {
  id           String    @id @default(cuid())
  schoolId     String
  jobId        String?
  /// QUALITY | TAG | READING | DUPLICATE
  tool         String    @db.VarChar(20)
  /// KEY_ERROR | MULTIPLE_CORRECT | WEAK_DISTRACTOR | SPELLING | UNCLEAR | TAG | READING_LEVEL | DUPLICATE
  kind         String    @db.VarChar(20)
  questionId   String?   @db.VarChar(60)
  passageId    String?   @db.VarChar(60)
  /// 1 = most serious (wrong key, several correct answers) … 5 = minor
  severity     Int       @default(3)
  detail       String    @db.Text
  data         Json
  /// SUGGESTED | APPROVED | REJECTED
  status       String    @default("SUGGESTED") @db.VarChar(12)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([schoolId, tool, status])
  @@index([questionId])
}

/// Every call to the AI provider (success or failure), for the admin's log and the rate limits.
model AiRequestLog {
  id        String   @id @default(cuid())
  schoolId  String
  tool      String   @db.VarChar(20)
  provider  String   @db.VarChar(20)
  model     String   @db.VarChar(80)
  ok        Boolean
  items     Int      @default(0)
  ms        Int      @default(0)
  error     String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// ------------------------------------------------------------------ 🗺️ MAP plans (one per student, subject and term)

/// A student's MAP plan, built from their MAP goal areas (RIT band per area). DRAFT until the teacher reviews and
/// sends it; then each area becomes an adaptive question set of the student's band. Rebuilt after new MAP scores.
model MapPlan {
  id            String    @id @default(cuid())
  schoolId      String
  classId       String
  studentId     String
  /// READING | LANGUAGE
  subject       String    @db.VarChar(10)
  /// the MAP term the plan comes from, e.g. "Fall 2026"
  term          String    @db.VarChar(40)
  /// DRAFT | SENT
  status        String    @default("DRAFT") @db.VarChar(10)
  /// the areas: [{group, rit, low, high, status, skillIds, count}]
  items         Json
  note          String?   @db.VarChar(1000)
  dueAt         DateTime?
  assignmentIds Json?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sentAt        DateTime?
  /// set when the teacher edits the draft: new MAP scores then keep it (untouched drafts are made again)
  editedAt      DateTime?

  @@index([classId, subject, term])
  @@index([studentId])
}

// ------------------------------------------------------------------ Update 19: follow-up, words, worksheets, goals

/// 🚨 A student who needs attention (no practice, persistent weakness, level drops, late work, MAP risk, rapid
/// guessing). Teachers of the class and the head of department see it; the teacher records what was done.
model StudentAlert {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String?
  studentId   String
  /// NO_PRACTICE | WEAK_SKILL | DROPPED | LATE_WORK | MAP_RISK | RAPID_GUESS
  kind        String    @db.VarChar(20)
  /// one alert per student and key (e.g. NO_PRACTICE|2026-W41): it is not raised again the same week
  key         String    @db.VarChar(120)
  detail      String    @db.VarChar(500)
  /// OPEN | HANDLED
  status      String    @default("OPEN") @db.VarChar(10)
  action      String?   @db.VarChar(1000)
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([studentId, key])
  @@index([schoolId, status])
  @@index([classId, status])
}

/// 📖 Dictionary cache: the English meaning of a word (free dictionary API), editable by the school.
model WordEntry {
  id          String   @id @default(cuid())
  schoolId    String
  word        String   @db.VarChar(64)
  phonetic    String?  @db.VarChar(120)
  audioUrl    String?  @db.VarChar(500)
  /// [{partOfSpeech, definition, example, synonyms[], antonyms[]}]
  meanings    Json
  /// API | SCHOOL (a teacher or admin wrote or edited it) | NONE (not found)
  source      String   @default("API") @db.VarChar(10)
  /// a curriculum vocabulary word: the school's own definition is shown first
  isVocab     Boolean  @default(false)
  /// optional Arabic meaning, shown to students only as a help (tap to see)
  arabicGloss String?  @db.VarChar(200)
  /// original example sentence in context (used by the in-context word quiz)
  contextSentence String? @db.VarChar(300)
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, word])
}

/// 📒 The student's word notebook: every word looked up, with a weekly quiz.
model StudentWord {
  studentId   String
  word        String    @db.VarChar(64)
  lookups     Int       @default(1)
  firstAt     DateTime  @default(now())
  lastAt      DateTime  @default(now())
  quizRight   Int       @default(0)
  quizWrong   Int       @default(0)
  lastQuizAt  DateTime?
  /// spaced review of this word: when it is due and which step (1, 3, 7, 21, 60 days)
  nextReviewAt DateTime?
  reviewStep  Int       @default(0)
  /// the student added it on purpose (word journal), with their own example and a not-example
  myExample   String?   @db.VarChar(300)
  notExample  String?   @db.VarChar(300)

  @@id([studentId, word])
  @@index([studentId, lastAt])
}

/// 🔎 A word students tapped that has no meaning yet (Update 42C): one row per school and word, how often it was
/// tapped and the last passage sentence it was in (no student data). Shown on the admin dictionary page.
model MissingWord {
  id           String    @id @default(cuid())
  schoolId     String
  word         String    @db.VarChar(64)
  count        Int       @default(1)
  lastSentence String?   @db.VarChar(300)
  /// when the free dictionary was last asked (it is asked again after 7 days)
  checkedAt    DateTime?
  firstAt      DateTime  @default(now())
  lastAt       DateTime  @default(now())

  @@unique([schoolId, word])
  @@index([schoolId, count])
}

/// 💬 A teacher's comment on a student's work (seen by the student and the parent).
model WorkComment {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  assignmentId String?
  authorId     String
  body         String   @db.VarChar(2000)
  createdAt    DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([assignmentId])
}

/// 🚩 A student marks a question as unclear; the admin checks it.
model QuestionFlag {
  id           String    @id @default(cuid())
  schoolId     String
  questionId   String
  studentId    String
  reason       String    @db.VarChar(40)
  note         String?   @db.VarChar(500)
  /// OPEN | FIXED | DISMISSED | REMOVED (r68: the question was deleted, hidden or archived)
  status       String    @default("OPEN") @db.VarChar(10)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([questionId, studentId])
  @@index([schoolId, status])
}

/// 🎯 Weekly goals: a student's own goal (studentId) or a class goal set by the teacher (classId).
model WeeklyGoal {
  id          String   @id @default(cuid())
  schoolId    String
  /// STUDENT | CLASS
  scope       String   @db.VarChar(10)
  ownerId     String
  /// Monday of the week (UTC date)
  weekStart   DateTime
  /// ANSWERS | MINUTES | TASKS
  kind        String   @db.VarChar(10)
  target      Int
  title       String?  @db.VarChar(160)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([scope, ownerId, weekStart])
}

/// 🎫 Exit ticket: 3 quick questions at the end of a lesson, results live for the teacher.
model ExitTicket {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String
  createdById String
  title       String    @db.VarChar(191)
  questionIds Json
  /// OPEN | CLOSED
  status      String    @default("OPEN") @db.VarChar(10)
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  @@index([classId, status])
  @@index([createdById]) // ⚡ r67: a teacher's exit tickets, counted for the menu numbers on every page (was a table scan)
}

model ExitTicketAnswer {
  ticketId   String
  studentId  String
  questionId String
  isCorrect  Boolean
  response   Json
  createdAt  DateTime @default(now())

  @@id([ticketId, studentId, questionId])
  @@index([ticketId])
  /// Second Chance reads a student's exit-ticket mistakes
  @@index([studentId, createdAt])
}

/// 🖨 A worksheet a teacher built from chosen questions (kept to print again or share with colleagues).
model Worksheet {
  id          String   @id @default(cuid())
  schoolId    String
  createdById String
  title       String   @db.VarChar(191)
  grade       Int?
  questionIds Json
  /// shared with the other English teachers of the school
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, shared])
  @@index([createdById])
}

// ------------------------------------------------------------------ Update 20: MAP practice test (simulation)

/// 🗺️ A window when students take the MAP practice test (e.g. two weeks before Winter), for one grade or all.
model MapSimWindow {
  id          String    @id @default(cuid())
  schoolId    String
  title       String    @db.VarChar(160)
  /// null = every grade
  grade       Int?
  /// the real MAP season it prepares for: WINTER | SPRING | FALL
  season      String    @db.VarChar(10)
  /// ["READING","LANGUAGE"]
  subjects    Json
  /// questions per subject (MAP-like: 50)
  items       Int       @default(50)
  opensAt     DateTime
  closesAt    DateTime
  createdById String
  createdAt   DateTime  @default(now())
  /// MAP Test tab (teacher / admin): AUTO (adaptive, simulates MAP Growth) | MANUAL (a fixed list of items); null = AUTO
  kind        String?   @db.VarChar(8)
  /// the classes it is for (null = every student of `grade`, the old school-wide window)
  classIds    Json?
  /// only these students of those classes (null = the whole classes)
  studentIds  Json?
  /// MANUAL: the items in order [{ id, area, rit }]
  itemIds     Json?
  /// AUTO: the share of each goal area in percent { LIT: 34, INFO: 33, VOCAB: 33 } (null = even)
  areaShares  Json?
  /// AUTO: questions the teacher took out of the pool
  excludedIds Json?
  /// a draft is not shown to students yet (manual tests while they are being built)
  draft       Boolean?
  /// MANUAL: how it was built { areas, ritLow, ritHigh }
  settings    Json?
  updatedAt   DateTime?
  /// r69 live time: minutes per subject sitting from the student's start (null = untimed, like MAP Growth)
  timeLimitMin Int?
  /// r69 live time: extra minutes per student { "<studentId>": +5 | -5 … }
  studentMinutes Json?

  @@index([schoolId, closesAt])
}

/// One student's adaptive test in one subject (or a 5-question warm-up when kind = WARMUP).
model MapSimSession {
  id           String    @id @default(cuid())
  windowId     String?
  schoolId     String
  studentId    String
  subject      String    @db.VarChar(10)
  /// SIM | WARMUP
  kind         String    @default("SIM") @db.VarChar(10)
  /// IN_PROGRESS | DONE
  status       String    @default("IN_PROGRESS") @db.VarChar(12)
  total        Int
  startRit     Float
  rit          Float
  se           Float     @default(15)
  answered     Int       @default(0)
  correct      Int       @default(0)
  rapid        Int       @default(0)
  servedQuestionId String?
  servedAt     DateTime?
  /// the result (DONE): RIT range and each goal-area group
  resultRit    Int?
  resultLow    Int?
  resultHigh   Int?
  areas        Json?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([windowId, studentId])
  @@index([studentId, status])
}

model MapSimAnswer {
  sessionId  String
  n          Int
  questionId String
  /// LIT | INFO | VOCAB | GRAMMAR | MECH | WRITING
  area       String   @db.VarChar(10)
  itemRit    Float
  isCorrect  Boolean
  responseMs Int
  rapid      Boolean  @default(false)
  createdAt  DateTime @default(now())
  /// the answer given (normalized), for the item analysis (most chosen wrong answer)
  response   Json?

  @@id([sessionId, n])
  @@index([questionId])
}

// ------------------------------------------------------------------ Update 20: notes, writing & reading aloud, errors

/// 🔒 A private note about a student (staff only: never shown to the student or the parent).
model TeacherNote {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  authorId  String
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

/// ✍️ A writing task (scored with a 4-point rubric) or a 🎙 reading-aloud task (recorded, fluency 1–4).
model WritingTask {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String
  createdById String
  /// WRITE | READ_ALOUD
  kind        String    @default("WRITE") @db.VarChar(12)
  title       String    @db.VarChar(191)
  prompt      String    @db.Text
  /// the text to read (READ_ALOUD) or a passage to write about
  passage     String?   @db.Text
  minWords    Int?
  dueAt       DateTime?
  startAt     DateTime? // owner r68 §D: the day students see it (null: at once); dueAt is the end
  /// NARRATIVE | INFORMATIONAL | OPINION | HOW_TO | RESEARCH | FREE (genre rubric and checklist)
  genre       String    @default("FREE") @db.VarChar(14)
  /// the skill the writing practises (scores feed its mastery and reteach routing)
  skillId     String?
  /// plan → draft → revise stages (with an organizer and sentence frames)
  staged      Boolean   @default(false)
  /// source-based writing: up to 3 sources [{ title, text }] and research questions [{ q, kind, options?, answer? }]
  sources     Json?
  research    Json?
  /// AI trait feedback drafts for the teacher to approve
  aiFeedback  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  /// 🔒 locked (exam-style) writing with a teacher rubric: written on the locked page, graded on the grading page
  locked       Boolean?
  /// the writing prompt as sanitized HTML (bold, italic, lists, headings); `prompt` keeps the plain text
  promptHtml   String?   @db.Text
  /// the grade level the task is written for (1–12)
  gradeLevel   Int?
  /// the time limit in minutes (counted from the student's own start, enforced on the server)
  timeLimitMin Int?
  /// the saved rubric it was built from (if any) and the rubric snapshot used for grading { title, criteria: [{ key, title, description, levels: [{ label, points, description }] }] }
  rubricId     String?
  rubric       Json?
  /// CLASS | GROUP | STUDENTS (null = the whole class, as before)
  assignTo     String?   @db.VarChar(8)
  /// the support group (Intervention) it was assigned to
  groupId      String?
  /// the students it was assigned to (GROUP / STUDENTS); null = every student of the class
  studentIds   Json?
  /// the teacher's own rubric text ("Write or paste my rubric": a pasted table or typed lines), kept as written and sent to the AI as the teacher's wording
  rubricText   String?   @db.Text
  /// the teacher's notes for AI grading (e.g. "focus on the thesis; this class just learned paragraphs"); never student identifiers
  aiNotes      String?   @db.Text

  @@index([classId, createdAt])
}

/// 📏 A writing rubric a teacher saved for reuse (their own, or shared with the school's teachers).
model WritingRubric {
  id          String    @id @default(cuid())
  schoolId    String
  createdById String
  title       String    @db.VarChar(120)
  /// shared with every teacher of the school
  shared      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([schoolId, createdAt])
}

/// One criterion of a saved rubric with its performance levels [{ label, points, description }] (lowest first).
model WritingRubricCriterion {
  id          String  @id @default(cuid())
  rubricId    String
  position    Int
  title       String  @db.VarChar(120)
  description String? @db.VarChar(500)
  levels      Json

  @@index([rubricId, position])
}

/// 🛡️ What happened on the locked writing page (leaving, pastes, extensions, reloads, start / submit, a teacher's reopen).
model WritingIntegrityEvent {
  id        String   @id @default(cuid())
  taskId    String
  studentId String
  /// START | HIDDEN | BLUR | FULLSCREEN | RELOAD | PASTE | COPY | DROP | MENU | EXTENSION | SUBMIT | AUTO_SUBMIT | TIME_UP | REOPEN | RETURNED
  kind      String   @db.VarChar(12)
  detail    String?  @db.VarChar(300)
  /// the teacher who reopened / returned (teacher events only)
  byUserId  String?
  at        DateTime @default(now())

  @@index([taskId, studentId, at])
}

model WritingSubmission {
  taskId      String
  studentId   String
  text        String?   @db.Text
  /// the recording (READ_ALOUD), webm/ogg/mp4 audio, at most 2 MB
  audio       Bytes?    @db.MediumBlob
  audioType   String?   @db.VarChar(60)
  /// DRAFT | SUBMITTED | SCORED
  status      String    @default("DRAFT") @db.VarChar(10)
  /// rubric 0–4 each: {ideas, organization, language, conventions} or {fluency, accuracy, expression}
  scores      Json?
  comment     String?   @db.VarChar(2000)
  scoredById  String?
  /// reading aloud: words correct per minute (the teacher's count)
  wcpm        Int?
  submittedAt DateTime?
  scoredAt    DateTime?
  /// PLAN | DRAFT | REVISE | FINAL (staged tasks)
  stage       String?   @db.VarChar(8)
  /// the organizer the student filled in at the plan stage
  plan        Json?
  /// the first draft kept when the student revises
  firstDraft  String?   @db.Text
  /// the student's self-check before submitting { itemId: true }
  checklist   Json?
  /// research question answers (source-based writing)
  researchAnswers Json?
  /// AI draft: { traits: { name: { score, comment } }, conventions: [{ code, example }], summary } — PENDING until the teacher approves
  aiDraft     Json?
  /// NONE | PENDING | APPROVED | DISMISSED
  aiStatus    String    @default("NONE") @db.VarChar(9)
  updatedAt   DateTime  @updatedAt
  /// 🔒 locked writing: when the student pressed Start (the time limit counts from here)
  startedAt   DateTime?
  /// the last autosave
  autosavedAt DateTime?
  /// MANUAL | AUTO (left the page twice) | TIME (time limit)
  submitMode  String?   @db.VarChar(6)
  /// times the student left the locked page (counted on the server)
  leaveCount  Int?
  /// lock bookkeeping { opens, lastOpenAt, lastLeaveAt, extension }
  lock        Json?
  /// the teacher's grading { levels: { key: index }, comment, sentences: [{ index, text, comment }], approved?: {…} }
  grading     Json?
  /// the AI's suggested grade for the teacher (never shown to the student)
  aiGrade     Json?
  /// when the teacher approved and returned the grade
  returnedAt  DateTime?
  /// the approved rubric score in percent
  scorePct    Int?

  @@id([taskId, studentId])
  @@index([studentId, status])
}

/// 🩺 Errors the platform met (server and browser), for the developer. No student data, only the message.
model ErrorLog {
  id        String   @id @default(cuid())
  /// SERVER | BROWSER
  source    String   @db.VarChar(10)
  message   String   @db.VarChar(1000)
  path      String?  @db.VarChar(300)
  digest    String?  @db.VarChar(100)
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 📝 The beginning-of-year Diagnostic Test of a grade (replaces the separate placement test / placement check):
/// one fixed set of ~50 questions covering every strand and standard, the same for every student of the grade.
model DiagnosticTest {
  id           String    @id @default(cuid())
  schoolId     String
  grade        Int
  /// school year, e.g. "2026-2027"
  year         String    @db.VarChar(9)
  title        String    @db.VarChar(191)
  assessmentId String
  /// DRAFT (being reviewed) | OPEN (students can take it) | CLOSED
  status       String    @default("DRAFT") @db.VarChar(10)
  opensAt      DateTime?
  closesAt     DateTime?
  /// level bands in % { above: 85, on: 65 }
  bands        Json?
  /// adaptive (cross-grade): the same 50 skill slots for every grade, the difficulty follows each student
  adaptive     Boolean   @default(false)
  /// adaptive tests: { blueprint: [anchor…], items: [{ id, a, st, d, p, g }] } frozen when built
  design       Json?
  /// BOY | MOY | EOY — beginning, middle or end of year (growth across the three)
  period       String    @default("BOY") @db.VarChar(3)
  createdById  String?
  createdAt    DateTime  @default(now())

  @@index([schoolId, grade])
  @@index([assessmentId]) // the Diagnostic of an assessment (Update 46)
}

/// A student's Diagnostic result (written when they finish), with the analysis by standard and strand.
model DiagnosticScore {
  id           String    @id @default(cuid())
  diagnosticId String
  studentId    String
  assignmentId String
  correct      Int
  total        Int
  pct          Float
  /// BELOW | ON | ABOVE
  level        String    @db.VarChar(6)
  /// [{ code, label, strand, correct, total }]
  byStandard   Json
  /// [{ strand, label, correct, total }]
  byStrand     Json
  rapid        Int       @default(0)
  minutes      Int       @default(0)
  /// adaptive tests: ability in grade units (5.3 = reading like a Grade 5 student early in the year), its error,
  /// the estimated MAP Reading RIT and the result by MAP goal area [{ group, name, theta, score }]
  theta        Float?
  thetaSE      Float?
  ritEstimate  Int?
  byArea       Json?
  completedAt  DateTime
  /// shared with the student and the family (their Family Report)
  sharedAt     DateTime?
  teacherNote  String?   @db.VarChar(1000)

  @@unique([diagnosticId, studentId])
  @@index([studentId])
}

/// 🔊 Oral reading fluency: words correct per minute, from a teacher's check or a scored reading-aloud recording.
model FluencyCheck {
  id          String   @id @default(cuid())
  studentId   String
  wcpm        Int
  /// % of words read correctly
  accuracy    Int?
  note        String?  @db.VarChar(500)
  /// TEACHER | RECORDING | COACH (the Fluency Coach's 1-minute check)
  source      String   @default("TEACHER") @db.VarChar(10)
  checkedById String?
  checkedAt   DateTime @default(now())
  /// FALL | WINTER | SPRING (Hasbrouck–Tindal norm season at the time of the check)
  season      String?  @db.VarChar(6)
  /// national percentile (Hasbrouck & Tindal 2017) for the grade and season
  percentile  Int?
  /// prosody traits 1–4: { phrasing, smoothness, pace, intonation }
  prosody     Json?
  /// comprehension check after the reading, 0–100
  comprehension Int?

  @@index([studentId, checkedAt])
}

/// 🗓️ The weekly check: a few questions a week that keep each student's level and RIT estimate current.
model WeeklyCheck {
  id           String    @id @default(cuid())
  studentId    String
  /// Sunday of the week (yyyy-mm-dd)
  week         String    @db.VarChar(10)
  assignmentId String
  correct      Int       @default(0)
  total        Int       @default(0)
  ritBefore    Int?
  ritAfter     Int?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([studentId, week])
}

/// 🎙 One Fluency Coach reading (the audio itself is never kept: it is scored, then dropped).
/// MINUTE = the 1-minute check (official: it sets the fluency level on the rubric); PASSAGE = the whole passage (practice).
model FluencyPractice {
  id           String   @id @default(cuid())
  studentId    String
  mode         String   @db.VarChar(8)
  /// "RM:<ReadMasterVersion id>" or "RP:<ReadingPassage id>"
  passageKey   String   @db.VarChar(60)
  title        String   @db.VarChar(191)
  lexile       Int?
  wordsRead    Int
  wordsCorrect Int
  seconds      Int
  wcpm         Int
  /// % of the words read that were read correctly
  accuracy     Int
  /// 1–4 (NAEP oral reading fluency scale), when the AI could judge it
  expression   Int?
  /// BELOW | ON | ABOVE on the school's WCPM rubric (1-minute checks)
  level        String?  @db.VarChar(6)
  /// [{ i, word, heard, kind }] — the words to practise
  errors       Json
  /// sound / spelling patterns behind the errors, e.g. "-tion endings"
  patterns     Json?
  /// the plan made after this reading (goal, steps, next check)
  plan         Json?
  /// prosody traits 1–4: { phrasing, smoothness, pace, intonation }
  prosody      Json?
  /// words the student hesitated on for more than 3 seconds (counted as errors)
  hesitations  Int?
  /// comprehension check after the reading, 0–100
  comprehension Int?
  /// which practice: PASSAGE | MINUTE | ECHO | PHRASED | DRILL | REPEATED
  practiceKind String?  @db.VarChar(10)
  /// the repeated-reading trial number on this passage (1, 2, 3 …)
  trial        Int?
  /// national percentile for the grade and season (official 1-minute checks)
  percentile   Int?
  createdAt    DateTime @default(now())

  @@index([studentId, createdAt])
}

/// 📝 Daily Dictation (its own tab in the Fluency Coach): one listen-and-type item a day, with its own small
/// up/down difficulty engine (src/server/dictation/engine.ts), separate from the Fluency Coach's WCPM level.
model DictationStudent {
  studentId  String   @id
  schoolId   String
  /// the bank tier (1..N, src/server/dictation/items.ts), never below 1 or above the bank's top tier
  tier       Int
  startTier  Int
  updatedAt  DateTime @updatedAt

  @@index([schoolId])
}

/// One day's Daily Dictation attempt (one row per student per calendar day — DICTATION_DAY_FORMAT in engine.ts).
model DictationAttempt {
  id          String   @id @default(cuid())
  studentId   String
  schoolId    String
  /// the calendar day this attempt counts for (yyyy-mm-dd; configurable "now" in engine.ts, not real wall-clock in tests)
  day         String   @db.VarChar(10)
  itemId      String   @db.VarChar(20)
  tier        Int
  typed       String   @db.VarChar(500)
  /// word-level diff ops: [{ kind: "ok"|"missing"|"extra"|"misspelled", text, typedText? }]
  diff        Json
  errorCount  Int
  /// no errors at all
  clean       Boolean
  tierBefore  Int
  tierAfter   Int
  createdAt   DateTime @default(now())

  @@unique([studentId, day])
  @@index([studentId, createdAt])
}

/// 👪 A report for the family, prepared by the platform or written by the teacher. Teachers' reports reach the
/// family only after a school admin approves them (status PENDING → APPROVED, or RETURNED with a note).
model FamilyReport {
  id              String    @id @default(cuid())
  schoolId        String
  studentId       String
  /// AUTO (prepared by the platform) | MANUAL (written by the teacher) | PROGRESS (the progress report) | DIAGNOSTIC
  kind            String    @db.VarChar(12)
  title           String    @db.VarChar(191)
  /// { summary, sections: [{ heading, lines[] }], message } — what the family sees
  content         Json
  /// DIAGNOSTIC: the Diagnostic test id
  refId           String?   @db.VarChar(40)
  /// DRAFT | PENDING | RETURNED | APPROVED | WITHDRAWN
  status          String    @db.VarChar(10)
  createdById     String
  submittedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?   @db.Text
  seenByParentAt  DateTime?
  seenByStudentAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  @@index([schoolId, status])
  @@index([studentId, status])
}

/// 🧭 A change (or a suggested change) of a question's CCSS standard made by the MAP classification:
/// APPLIED (clearly wrong: written wrongly, another grade, a code that does not exist, a Mechanics skill),
/// SUGGESTED (read from the wording: waits for an admin), APPROVED / REJECTED. The old standard is kept here.
model QuestionStandardFix {
  id             String    @id @default(cuid())
  schoolId       String
  questionId     String
  fromCode       String?   @db.VarChar(40)
  toCode         String    @db.VarChar(40)
  reason         String    @db.VarChar(255)
  status         String    @db.VarChar(10)
  createdAt      DateTime  @default(now())
  reviewedById   String?
  reviewedAt     DateTime?

  @@index([schoolId, status])
  @@index([questionId])
}

/// One place for "where is this student": the unified level and its source, the latest MAP RITs, Lexile, the
/// overall ability, the predicted RIT for the next MAP term and the chance of reaching the goal, the active
/// misconceptions. Rebuilt by src/server/insights/student-profile.ts (after MAP imports, Weekly Checks, nightly).
model StudentProfile {
  studentId        String   @id
  schoolId         String
  level            String   @db.VarChar(8) // BELOW | ON | ABOVE | UNKNOWN
  levelSource      String   @db.VarChar(16) // MAP | WEEKLY_CHECK | DIAGNOSTIC | PRACTICE | NONE
  levelAt          DateTime?
  readingRit       Int?
  languageRit      Int?
  estReadingRit    Int?
  estLanguageRit   Int?
  lexile           Int?
  theta            Float?
  practiceDays14   Int      @default(0)
  predictedTerm    String?  @db.VarChar(12)
  predictedReading Int?
  predictedLanguage Int?
  predictedRange   Int?
  goalReading      Int?
  goalChance       Int?
  misconceptions   Json?
  weakestArea      String?  @db.VarChar(12)
  updatedAt        DateTime @updatedAt

  @@index([schoolId, level])
  /// mastered / developing skills, missing prerequisites (root gaps), the learning path, the trajectory and growth rate
  intelligence     Json?
  /// 🚨 early warning: probability (0–100) of NOT reaching the MAP goal, its reasons and the actions to take
  riskScore        Int?
  riskReasons      Json?
}

/// A teacher's intervention: a small group on one skill for a period; the platform compares mastery before and after.
model Intervention {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String
  skillId     String
  title       String
  studentIds  Json
  createdById String
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  baseline    Json // { studentId: mastery }
  result      Json? // { studentId: mastery } at evaluation
  evaluatedAt DateTime?
  status      String    @default("ACTIVE") @db.VarChar(10) // ACTIVE | DONE

  @@index([classId, status])
  @@index([schoolId, status])
}

/// One point of a student's risk history (features → score), kept to learn which signals predict the MAP outcome.
model RiskSnapshot {
  id        BigInt   @id @default(autoincrement())
  studentId String
  schoolId  String
  takenOn   DateTime @db.Date
  score     Int
  features  Json
  model     String   @db.VarChar(16) // EXPERT | LEARNED
  createdAt DateTime @default(now())

  @@unique([studentId, takenOn])
  @@index([schoolId, takenOn])
}

/// Models the platform learns from its own data per school: RISK (logistic weights of the early warning) and
/// ACTION_WEIGHTS (how well each kind of learning-path step works). Kept with their quality metrics.
model PredictionModel {
  id        String   @id @default(cuid())
  schoolId  String
  kind      String   @db.VarChar(20)
  weights   Json
  metrics   Json
  n         Int      @default(0)
  trainedAt DateTime @default(now())

  @@unique([schoolId, kind])
}


