  message     String
  evidence    Json
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, resolvedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  link      String?
  readAt    DateTime?
