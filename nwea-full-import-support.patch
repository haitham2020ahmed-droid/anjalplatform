+++ b/src/server/map/projected-proficiency.ts
@@ -0,0 +1,122 @@
+/**
+ * 📄 NWEA MAP Growth “Class Profile” report (PDF, **Projected Proficiency tab** → “Projected Proficiency by
+ * Student” table) → MAP scores. Like the Instructional Areas tab (class-profile.ts), this tab has no Student ID
+ * column — students are matched by name only (see importMapScores) — and it gives only the Fall RIT and the
+ * projected Spring RIT (no percentile, no instructional-area breakdown, no Lexile). The proficiency category
+ * NWEA prints next to each row ("Below Proficient" / "Proficient" / "Advanced") is read but not stored: the
+ * platform has no field for it yet, and the RIT numbers alone already drive MAP plans and reports correctly.
+ *
+ * Layout: one table per subject, printed from reports.mapnwea.org. A heading “Projected Proficiency by Student”,
+ * a “<class> | Grade <n> | <school> | <subject> | Projected with …” line, then one row per tested student:
+ * “Last, First” · Grade · Fall RIT · Projected Spring RIT · Category. Continuation pages repeat the column-header
+ * row but not the section title, so “are we inside the table” carries across pages, same as class-profile.ts. A
+ * student with “No test data (…)” instead of numbers is skipped, as is the trailing Lexile/Quantile legal notice.
+ */
+import type { PdfItem } from "./asg";
+import { MAP_TEMPLATE_HEADERS } from "./student-map";
+
+export interface ProjProfRow { name: string; grade: number | null; rit: number; projectedRit: number; category: string | null }
+export interface ProjProfParsed { subject: "READING" | "LANGUAGE_USAGE" | null; className: string | null; term: string | null; season: "FALL" | "WINTER" | "SPRING"; year: number; rows: ProjProfRow[] }
+
+const START_RE = /Projected Proficiency by Student/i;
+const STOP_RE = /Lexile.{0,3}\s*and\s*Quantile|trademarks of MetaMetrics/i;
+const CLASS_RE = /^(\S+)\s*\|\s*Grade/;
+const NO_DATA_RE = /No test data/i;
+const DATE_RE = /^\d{1,2}\/\d{1,2}\/\d{2,4},?$/;
+
+/** Page items grouped into text lines (items within 0.5pt of the same vertical position merged), top-to-bottom. Identical to class-profile.ts's pageLines — kept local so this file has no sibling-file coupling beyond the shared PdfItem type. */
+function pageLines(items: PdfItem[]): { d: number; text: string }[] {
+  const sorted = [...items].sort((a, b) => b.y - a.y || a.x - b.x);
+  const out: { d: number; text: string }[] = [];
+  for (const it of sorted) {
+    const d = -it.y;
+    const last = out[out.length - 1];
+    if (last && Math.abs(last.d - d) <= 0.5) last.text += " " + it.s;
+    else out.push({ d, text: it.s });
+  }
+  return out;
+}
+
+/** The PDF pages (from asg.ts's pdfPages) → the parsed Projected Proficiency table (one subject per call). */
+export function parseProjectedProficiency(pages: PdfItem[][]): ProjProfParsed {
+  let subject: ProjProfParsed["subject"] = null;
+  let className: string | null = null;
+  let term: string | null = null;
+  let inTable = false;
+  const rows: ProjProfParsed["rows"] = [];
+
+  for (const items of pages) {
+    const withD = items.map((it) => ({ ...it, d: -it.y }));
+    const lines = pageLines(items);
+    if (!term) { for (const l of lines) { const m = l.text.match(/(Fall|Winter|Spring)\s+(\d{4})-(\d{4})/i); if (m) { term = `${m[1][0].toUpperCase()}${m[1].slice(1).toLowerCase()} ${m[2]}-${m[3]}`; break; } } }
+
+    type Marker = { d: number; start: boolean };
+    const markers: Marker[] = [];
+    for (const l of lines) {
+      if (START_RE.test(l.text)) markers.push({ d: l.d, start: true });
+      else if (STOP_RE.test(l.text)) markers.push({ d: l.d, start: false });
+      const cm = l.text.match(CLASS_RE);
+      if (cm && !className) {
+        className = cm[1];
+        if (!subject) { if (/\|\s*Reading\s*\|/i.test(l.text)) subject = "READING"; else if (/\|\s*Language Usage\s*\|/i.test(l.text)) subject = "LANGUAGE_USAGE"; }
+      }
+    }
+    markers.sort((a, b) => a.d - b.d);
+
+    const segs: { lo: number; hi: number }[] = [];
+    let lo: number | null = inTable ? -Infinity : null;
+    for (const m of markers) {
+      if (m.start) { lo = m.d; }
+      else { if (lo !== null) segs.push({ lo, hi: m.d }); lo = null; }
+    }
+    if (lo !== null) segs.push({ lo, hi: Infinity });
+    inTable = lo !== null;
+
+    for (const seg of segs) {
+      const segWords = withD.filter((w) => w.d >= seg.lo && w.d < seg.hi);
+      if (!segWords.length) continue;
+
+      const anchors = segWords.filter((w) => w.x < 150 && /,/.test(w.s.trim()) && !DATE_RE.test(w.s.trim())).sort((a, b) => a.d - b.d);
+      if (!anchors.length) continue;
+      const floor = anchors[0].d - 20;
+      const rowWords = segWords.filter((w) => w.d > floor);
+
+      for (const a of anchors) {
+        const sameLine = rowWords.filter((w) => w !== a && Math.abs(w.d - a.d) <= 2 && w.x > a.x && w.x < 220).sort((x, y) => x.x - y.x);
+        const name = (a.s.trim() + (sameLine.length ? " " + sameLine.map((w) => w.s).join(" ") : "")).replace(/\s+/g, " ").replace(/,(?=\S)/g, ", ").trim();
+        const others = rowWords.filter((w) => w.x >= 220);
+        const mine = others.filter((w) => {
+          let best = anchors[0], bestDist = Math.abs(anchors[0].d - w.d);
+          for (const b of anchors) { const dist = Math.abs(b.d - w.d); if (dist < bestDist) { best = b; bestDist = dist; } }
+          return best === a && bestDist <= 20;
+        });
+        const toks = mine.sort((x, y) => x.x - y.x).map((w) => w.s.trim());
+        const text = toks.join(" ");
+        if (NO_DATA_RE.test(text) || toks.length < 3) continue; // "No test data (…)" or an incomplete/truncated row
+        const grade = parseInt(toks[0], 10), rit = Number(toks[1]), projectedRit = Number(toks[2]);
+        if (!Number.isFinite(rit) || !Number.isFinite(projectedRit)) continue;
+        const category = toks.slice(3).join(" ").trim() || null;
+        rows.push({ name, grade: Number.isFinite(grade) ? grade : null, rit, projectedRit, category });
+      }
+    }
+  }
+
+  const tm = (term ?? "").match(/(Fall|Winter|Spring) (\d{4})-(\d{4})/);
+  const season = (tm ? tm[1].toUpperCase() : "FALL") as ProjProfParsed["season"];
+  const year = tm ? (season === "FALL" ? Number(tm[2]) : Number(tm[3])) : new Date().getFullYear();
+  return { subject, className, term, season, year, rows };
+}
+
+/** Projected Proficiency rows → the platform's MAP template table (one row per student, Reading OR Language Usage). No percentile or instructional-area columns: this report doesn't have them. */
+export function projectedProficiencyToTable(p: ProjProfParsed): string[][] {
+  const H = [...MAP_TEMPLATE_HEADERS], col = (h: string) => H.indexOf(h);
+  const read = p.subject === "READING";
+  return [H, ...p.rows.map((r) => {
+    const row = H.map(() => "");
+    row[col("Student Name")] = r.name;
+    row[col("Grade")] = r.grade !== null ? String(r.grade) : "";
+    row[col(read ? "Reading Fall RIT" : "Language Fall RIT")] = String(r.rit);
+    row[col(read ? "Reading Spring Projection" : "Language Spring Projection")] = String(r.projectedRit);
+    return row;
+  })];
+}
