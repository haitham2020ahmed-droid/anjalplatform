# ---- Production settings for docker-compose.prod.yml (Phase 13) ----
# Copy to .env.production, fill in EVERY value, keep it off git (it is ignored) and
# readable only by the server administrator: chmod 600 .env.production
#
# Passwords: use long random letters and digits only (they are placed in database URLs).
# Generate each with:  openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32

# Public address (DNS must point to this server; Caddy gets the HTTPS certificate)
APP_DOMAIN=ela.example.edu.sa
# 32+ random bytes, base64: openssl rand -base64 32
APP_SECRET=
APP_VERSION=1.0.0

# MySQL accounts (created on first start by docker/mysql/01-accounts.sh)
MYSQL_ROOT_PASSWORD=
MYSQL_MIGRATE_PASSWORD=
MYSQL_APP_PASSWORD=
MYSQL_BACKUP_PASSWORD=

# Sessions (minutes)
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=60

# Reports
REPORT_PDF_CONCURRENCY=2

# Backups: time (Riyadh), retention, folder on the host. Put the PUBLIC key at
# docker/backup/backup-public.asc (see docs/DEPLOYMENT.md, "Backups").
BACKUP_TIME=01:30
BACKUP_KEEP_DAYS=30
BACKUP_DIR=./backups

# Monitoring (optional but recommended): see docs/DEPLOYMENT.md, "Monitoring"
ALERT_WEBHOOK_URL=
BACKUP_HEARTBEAT_URL=
HEARTBEAT_URL_ROLLUPS=
HEARTBEAT_URL_SECURITY_DIGEST=
HEARTBEAT_URL_ITEM_ANALYSIS=
LOG_LEVEL=info

# AI-assisted question bank (optional): only curriculum data is sent, never student data
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
