# ---- copy to .env and fill in; never commit .env ----
NODE_ENV=development
# MySQL 8+. Use a dedicated least-privilege user for the app.
DATABASE_URL="mysql://ela_app:CHANGE_ME@localhost:3306/alanjal_ela"
# 32+ random bytes (base64). Used to sign CSRF tokens. Generate: openssl rand -base64 32
APP_SECRET=
# Public base URL (used for secure cookie domain and links in notifications)
APP_URL=http://localhost:3000
# Session lifetime and idle timeout (minutes)
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=60
# Login rate limit: attempts per 15 minutes per username+IP
LOGIN_RATE_LIMIT=8
# sign-ins per IP address per 15 min (the whole school may share one public IP; raise for large schools)
LOGIN_RATE_LIMIT_PER_IP=300
# Account lockout after this many failed logins, for this many minutes
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Only for `npm run db:seed:demo` in development
DEMO_PASSWORD=
# File uploads (imports, logos)
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
# ---- Reports (Phase 10) ----
# Fonts embedded in PDFs (DejaVu Sans is bundled; add NotoNaskhArabic-*.ttf here for nicer Arabic)
REPORT_FONT_DIR=./assets/fonts
# School logo files (School.logoUrl holds a file name from this folder; remote URLs are not used)
REPORT_BRANDING_DIR=./storage/branding
# Leave empty to use Playwright's Chromium (npx playwright install chromium)
REPORT_CHROMIUM_PATH=
# PDFs rendered at the same time per server
REPORT_PDF_CONCURRENCY=2
# true only inside containers that cannot provide the Chromium sandbox
REPORT_CHROMIUM_NO_SANDBOX=false
# ---- AI-assisted question bank (optional) ----
# Server-side key for generating DRAFT questions; only curriculum data is sent, never student data.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# or Google Gemini (free tier): key from aistudio.google.com. Used when set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# optional: force one provider ("gemini" or "anthropic")
AI_PROVIDER=
# ---- Email (SMTP, optional) ----
# Admin messages to teachers are emailed too when these are set; without them messages arrive on the platform only.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=<the Gmail address>,
# SMTP_PASS=<16-letter app password, not the account password>. Port 587 with SMTP_SECURE=false uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
# "true" for port 465 (TLS from the start); "false" for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender shown to teachers, e.g. Al-Anjal Platform <yourname@gmail.com> (Gmail requires the same address as SMTP_USER)
MAIL_FROM=
